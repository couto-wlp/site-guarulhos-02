	['picanco', 'Picanço'],
	['pimentas', 'Pimentas'],
	['ponte-grande', 'Ponte Grande'],
	['porto-da-igreja', 'Porto da Igreja'],
	['presidente-dutra', 'Presidente Dutra'],
	['sadokim', 'Sadokim'],
	['sao-joao', 'São João'],
	['sao-roque', 'São Roque'],
	['taboao', 'Taboão'],
	['tanque-grande', 'Tanque Grande'],
	['torres-tibagy', 'Torres Tibagy'],
	['tranquilidade', 'Tranquilidade'],
	['varzea-do-palacio', 'Várzea do Palácio'],
	['vila-augusta', 'Vila Augusta'],
	['vila-barros', 'Vila Barros'],
	['vila-fatima', 'Vila Fátima'],
	['vila-galvao', 'Vila Galvão'],
