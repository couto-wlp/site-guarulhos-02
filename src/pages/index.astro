---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const todosServicos = await getCollection('servicos');
const ordemModelos = ['cacamba-4m3', 'cacamba-5m3', 'cacamba-6m3', 'cacamba-7m3', 'cacamba-8m3'];
const modelosDestaque = todosServicos
	.filter((servico) => ordemModelos.includes(servico.id))
	.sort((a, b) => ordemModelos.indexOf(a.id) - ordemModelos.indexOf(b.id));
const bairrosAtendidos = [
	['agua-azul', 'Água Azul'],
	['agua-chata', 'Água Chata'],
	['aracilia', 'Aracília'],
	['bananal', 'Bananal'],
	['bela-vista', 'Bela Vista'],
	['bom-clima', 'Bom Clima'],
	['bonsucesso', 'Bonsucesso'],
	['bosque-maia', 'Bosque Maia'],
	['cabucu', 'Cabuçu'],
	['cabucu-de-cima', 'Cabuçu de Cima'],
	['capelinha', 'Capelinha'],
	['cecap', 'CECAP'],
	['centro', 'Centro'],
	['cocaia', 'Cocaia'],
	['cumbica', 'Cumbica'],
	['fatima', 'Fátima'],
	['fortaleza', 'Fortaleza'],
	['gopouva', 'Gopoúva'],
	['invernada', 'Invernada'],
	['itaim', 'Itaim'],
	['itapegica', 'Itapegica'],
	['jardim-fortaleza', 'Jardim Fortaleza'],
	['jardim-itaim', 'Jardim Itaim'],
	['jardim-paraventi', 'Jardim Paraventi'],
	['jardim-presidente-dutra', 'Jardim Presidente Dutra'],
	['jardim-sao-joao', 'Jardim São João'],
	['jardim-vila-galvao', 'Jardim Vila Galvão'],
	['lavras', 'Lavras'],
	['macedo', 'Macedo'],
	['maia', 'Maia'],
	['mato-das-cobras', 'Mato das Cobras'],
	['monte-carmelo', 'Monte Carmelo'],
	['morro-grande', 'Morro Grande'],
	['morros', 'Morros'],
	['paraventi', 'Paraventi'],
	['parque-cecap', 'Parque CECAP'],
	['picanco', 'Picanço'],
	['pimentas', 'Pimentas'],
	['ponte-grande', 'Ponte Grande'],
	['porto-da-igreja', 'Porto da Igreja'],
	['presidente-dutra', 'Presidente Dutra'],
	['sadokim', 'Sadokim'],
	['sao-joao', 'São João'],
	['sao-roque', 'São Roque'],
	['taboao', 'Taboão'],
	['tanque-grande', 'Tanque Grande'],
	['torres-tibagy', 'Torres Tibagy'],
	['tranquilidade', 'Tranquilidade'],
	['varzea-do-palacio', 'Várzea do Palácio'],
	['vila-augusta', 'Vila Augusta'],
	['vila-barros', 'Vila Barros'],
	['vila-fatima', 'Vila Fátima'],
	['vila-galvao', 'Vila Galvão'],
	['vila-rio', 'Vila Rio'],
	['vila-rio-de-janeiro', 'Vila Rio de Janeiro'],
] as const;
---

<Layout 
	title="Caçamba de Entulho em Guarulhos | Aluga Caçamba Garantido"
	description="Caçamba de entulho em Guarulhos para reformas, obras, condomínios e empresas. Consulte capacidades e solicite entrega e retirada pelo WhatsApp."
	preloadImage="/home_truck.webp"
>
	<!-- 1. Hero -->
	<section class="max-w-7xl mx-auto w-full flex flex-col lg:flex-row items-center gap-10 lg:gap-12">
		<!-- Texto (Esquerda) -->
		<div class="flex-1 w-full text-center lg:text-left">
			<span class="inline-block py-2 px-4 rounded-full bg-gray-100 text-gray-900 font-bold text-sm mb-6 uppercase tracking-wider">
				Soluções para obras, condomínios e empresas
			</span>
			<h1 class="text-4xl md:text-5xl lg:text-[52px] font-black leading-none tracking-tighter text-gray-900">
				Caçamba de Entulho <br /> <span class="text-green-700">Em Guarulhos</span>
			</h1>
			
			<p class="text-base text-gray-600 mt-8 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
				Alugue caçamba de entulho em Guarulhos para reformas, condomínios, construtoras, empresas e demolições. Orientamos a escolha do tamanho conforme o volume, o peso e o tipo de resíduo da obra.
			</p>

			<div class="flex flex-col sm:flex-row justify-center lg:justify-start gap-5 mt-10">
			<a href="https://wa.me/5511943758808" target="_blank" class="inline-flex justify-center items-center px-10 py-5 bg-green-700 text-white text-base font-black rounded-xl transition-all hover:scale-105 active:scale-95 shadow-xl hover:shadow-green-700/40 gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                </svg>
					Chamar no WhatsApp
				</a>
				<a href="/servicos" class="inline-flex justify-center items-center px-10 py-5 bg-gray-100 text-gray-900 text-base font-black rounded-xl transition-all hover:bg-gray-200 hover:scale-105 active:scale-95">
					Conhecer Soluções
				</a>
			</div>
		</div>

		<!-- Imagem (Direita) -->
		<div class="flex-1 w-full">
			<div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white hover:shadow-primary/20 transition-all">
				<img 
					src="/home_truck.webp" 
					alt="Caminhão com caçamba estacionária verde para entulho" 
					width="900"
					height="750"
					loading="eager"
					fetchpriority="high"
					decoding="async"
					class="w-full h-auto object-cover aspect-video lg:aspect-[4/3.05] hover:scale-105 transition-transform duration-700"
				/>
			</div>
		</div>
	</section>

	<!-- 2. Modelos de caçamba -->
	<section aria-labelledby="modelos-cacamba">
		<div class="flex flex-col items-center text-center mb-12">
			<span class="text-sm font-black uppercase tracking-widest text-green-700 mb-3">Escolha conforme a sua obra</span>
			<h2 id="modelos-cacamba" class="text-3xl md:text-[47px] font-black text-gray-900 mb-4 tracking-tighter">
				Modelos de <span class="text-green-700">caçamba de entulho</span>
			</h2>
			<p class="text-gray-600 text-base md:text-lg leading-relaxed max-w-3xl mx-auto">
				Compare os tamanhos disponíveis e consulte a página de cada modelo. A indicação final considera o material, o volume estimado e o acesso ao endereço em Guarulhos.
			</p>
		</div>

		<div class="grid grid-cols-1 sm:grid-cols-2 gap-6 max-w-5xl mx-auto">
			{modelosDestaque.map((servico) => (
				<article class="bg-white border-2 border-gray-100 rounded-3xl overflow-hidden hover:border-green-600 hover:-translate-y-2 hover:shadow-xl transition-all duration-300 flex flex-col">
					<a href={`/servicos/${servico.id}`} class="block bg-green-50 p-5" aria-label={`Conhecer ${servico.data.title}`}>
						<img src={servico.data.image} alt={servico.data.title} width="480" height="360" loading="lazy" decoding="async" class="w-full aspect-[4/3] object-contain" />
					</a>
					<div class="p-6 flex flex-col flex-1">
						<h3 class="text-xl font-black text-gray-900 mb-3">{servico.data.title}</h3>
						<p class="text-sm text-gray-600 leading-relaxed mb-5 line-clamp-4">{servico.data.description}</p>
						<a href={`/servicos/${servico.id}`} class="mt-auto text-green-700 font-black hover:underline">Ver detalhes →</a>
					</div>
				</article>
			))}
		</div>

		<div class="text-center mt-10">
			<a href="/servicos" class="inline-flex px-8 py-4 bg-gray-100 text-gray-900 font-black rounded-xl hover:bg-gray-200 hover:scale-105 active:scale-95 transition-all">
				Comparar todos os serviços
			</a>
		</div>
	</section>

	<!-- 3. Como o orçamento é calculado -->
	<section class="w-[100vw] relative left-[50%] right-[50%] -ml-[50vw] -mr-[50vw] px-6 py-24 bg-gray-50 border-y border-gray-100" aria-labelledby="preco-cacamba">
		<div class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-[1.05fr_1fr] gap-12 items-center">
			<div>
				<span class="text-sm font-black uppercase tracking-widest text-green-700 mb-3 block">Orçamento sem adivinhação</span>
				<h2 id="preco-cacamba" class="text-3xl md:text-[47px] font-black text-gray-900 mb-6 tracking-tighter leading-tight">
					Quanto custa uma <span class="text-green-700">caçamba em Guarulhos?</span>
				</h2>
				<p class="text-gray-600 text-base md:text-lg leading-relaxed mb-8">
					O valor depende das características de cada atendimento. Para receber uma indicação adequada, informe o endereço da obra, os materiais que serão descartados, o volume aproximado e a data desejada.
				</p>
				<a href="https://wa.me/5511943758808?text=Olá! Gostaria de solicitar um orçamento de caçamba de entulho em Guarulhos." target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-8 py-4 bg-green-700 text-white font-black rounded-xl hover:bg-green-800 hover:scale-105 active:scale-95 transition-all shadow-lg">
					Solicitar orçamento pelo WhatsApp
				</a>
			</div>

			<div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
				<div class="bg-white border border-gray-200 rounded-2xl p-6">
					<span class="w-10 h-10 rounded-xl bg-green-100 text-green-800 font-black flex items-center justify-center mb-4">1</span>
					<h3 class="font-black text-gray-900 text-lg mb-2">Local da entrega</h3>
					<p class="text-sm text-gray-600 leading-relaxed">O bairro, o acesso do caminhão e o local de posicionamento fazem parte do planejamento.</p>
				</div>
				<div class="bg-white border border-gray-200 rounded-2xl p-6">
					<span class="w-10 h-10 rounded-xl bg-green-100 text-green-800 font-black flex items-center justify-center mb-4">2</span>
					<h3 class="font-black text-gray-900 text-lg mb-2">Tipo de resíduo</h3>
					<p class="text-sm text-gray-600 leading-relaxed">Concreto, terra, madeira, gesso e materiais mistos podem exigir orientações diferentes.</p>
				</div>
				<div class="bg-white border border-gray-200 rounded-2xl p-6">
					<span class="w-10 h-10 rounded-xl bg-green-100 text-green-800 font-black flex items-center justify-center mb-4">3</span>
					<h3 class="font-black text-gray-900 text-lg mb-2">Tamanho da caçamba</h3>
					<p class="text-sm text-gray-600 leading-relaxed">O volume e principalmente o peso do material orientam a escolha do modelo.</p>
				</div>
				<div class="bg-white border border-gray-200 rounded-2xl p-6">
					<span class="w-10 h-10 rounded-xl bg-green-100 text-green-800 font-black flex items-center justify-center mb-4">4</span>
					<h3 class="font-black text-gray-900 text-lg mb-2">Prazo e retirada</h3>
					<p class="text-sm text-gray-600 leading-relaxed">A data, o período de permanência e possíveis trocas são combinados no orçamento.</p>
				</div>
			</div>
		</div>
	</section>

	<div class="flex flex-col">
		<!-- 6. Depoimentos -->
		<section class="w-[100vw] relative left-[50%] right-[50%] -ml-[50vw] -mr-[50vw] px-6 py-24 bg-white">
			<div class="max-w-6xl mx-auto">
				<h2 class="text-3xl md:text-[47px] font-black mb-16 text-center tracking-tighter text-[#1c2331]">Depoimentos dos <span class="text-green-700">Nossos Clientes</span></h2>
				<div class="grid grid-cols-1 md:grid-cols-3 gap-10">
					<div class="bg-gray-50 p-10 rounded-3xl shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 flex flex-col">
						<div class="text-yellow-400 text-xl tracking-widest mb-4">★★★★★</div>
						<p class="text-gray-700 text-lg leading-relaxed mb-8 italic">"Solicitei uma caçamba rápida para a reforma da minha loja e o suporte foi excelente. Chegaram no horário, o entregador foi muito atencioso para não travar a garagem e a retirada foi bem ágil. Com toda certeza locarei de novo!"</p>
						<div class="flex items-center gap-4 mt-auto">
							<div class="relative w-14 h-14 shrink-0">
								<img src="/depoimento2.webp" alt="Fernanda Lima" width="56" height="56" loading="lazy" decoding="async" class="w-full h-full rounded-full object-cover shadow-sm border-2 border-green-100" />
								<div class="absolute -bottom-1 -right-1 bg-white rounded-full p-[2px] shadow-sm flex items-center justify-center">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="w-5 h-5">
										<path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8c-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C12.955 4 4 12.955 4 24s8.955 20 20 20c11.045 0 20-8.955 20-20C44 22.659 43.862 21.35 43.611 20.083z"/>
										<path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C16.318 4 9.656 8.337 6.306 14.691z"/>
										<path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
										<path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303c-0.792 2.237-2.231 4.166-4.087 5.571c0.001-0.001 0.002-0.001 0.003-0.002l6.19 5.238C36.971 39.205 44 34 44 24C44 22.659 43.862 21.35 43.611 20.083z"/>
									</svg>
								</div>
							</div>
							<div>
								<div class="font-black text-[#1c2331] text-base">Fernanda Lima</div>
								<div class="text-sm text-gray-500 font-semibold">Moradora do Aracília</div>
							</div>
						</div>
					</div>
					<div class="bg-gray-50 p-10 rounded-3xl shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 flex flex-col">
						<div class="text-yellow-400 text-xl tracking-widest mb-4">★★★★★</div>
						<p class="text-gray-700 text-lg leading-relaxed mb-8 italic">"Atuo com reformas e a agilidade na troca e locação das caçambas é essencial para o projeto não atrasar. Eles são fornecedores de ouro: suporte ágil pelo celular, valor honesto e respeito com o consumidor."</p>
						<div class="flex items-center gap-4 mt-auto">
							<div class="relative w-14 h-14 shrink-0">
								<img src="/depoimento3.webp" alt="Marcos Souza" width="56" height="56" loading="lazy" decoding="async" class="w-full h-full rounded-full object-cover shadow-sm border-2 border-green-100" />
								<div class="absolute -bottom-1 -right-1 bg-white rounded-full p-[2px] shadow-sm flex items-center justify-center">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="w-5 h-5">
										<path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8c-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C12.955 4 4 12.955 4 24s8.955 20 20 20c11.045 0 20-8.955 20-20C44 22.659 43.862 21.35 43.611 20.083z"/>
										<path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C16.318 4 9.656 8.337 6.306 14.691z"/>
										<path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
										<path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303c-0.792 2.237-2.231 4.166-4.087 5.571c0.001-0.001 0.002-0.001 0.003-0.002l6.19 5.238C36.971 39.205 44 34 44 24C44 22.659 43.862 21.35 43.611 20.083z"/>
									</svg>
								</div>
							</div>
							<div>
								<div class="font-black text-[#1c2331] text-base">Marcos Souza</div>
								<div class="text-sm text-gray-500 font-semibold">Construtor em Cumbica</div>
							</div>
						</div>
					</div>
					<div class="bg-gray-50 p-10 rounded-3xl shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-2 transition-all duration-300 flex flex-col">
						<div class="text-yellow-400 text-xl tracking-widest mb-4">★★★★★</div>
						<p class="text-gray-700 text-lg leading-relaxed mb-8 italic">"Fiz um descarte grande de entulhos e o sistema de aluguel foi muito simples e sem enrolação. Me explicaram exatamente sobre a medida certa da caçamba e o que podia ser recolhido. Trabalho rápido, justo e profissional."</p>
						<div class="flex items-center gap-4 mt-auto">
							<div class="relative w-14 h-14 shrink-0">
								<img src="/depoimento1.webp" alt="Paulo Mendes" width="56" height="56" loading="lazy" decoding="async" class="w-full h-full rounded-full object-cover shadow-sm border-2 border-green-100" />
								<div class="absolute -bottom-1 -right-1 bg-white rounded-full p-[2px] shadow-sm flex items-center justify-center">
									<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" class="w-5 h-5">
										<path fill="#FFC107" d="M43.611 20.083H42V20H24v8h11.303c-1.649 4.657-6.08 8-11.303 8c-6.627 0-12-5.373-12-12s5.373-12 12-12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C12.955 4 4 12.955 4 24s8.955 20 20 20c11.045 0 20-8.955 20-20C44 22.659 43.862 21.35 43.611 20.083z"/>
										<path fill="#FF3D00" d="M6.306 14.691l6.571 4.819C14.655 15.108 18.961 12 24 12c3.059 0 5.842 1.154 7.961 3.039l5.657-5.657C34.046 6.053 29.268 4 24 4C16.318 4 9.656 8.337 6.306 14.691z"/>
										<path fill="#4CAF50" d="M24 44c5.166 0 9.86-1.977 13.409-5.192l-6.19-5.238C29.211 35.091 26.715 36 24 36c-5.202 0-9.619-3.317-11.283-7.946l-6.522 5.025C9.505 39.556 16.227 44 24 44z"/>
										<path fill="#1976D2" d="M43.611 20.083H42V20H24v8h11.303c-0.792 2.237-2.231 4.166-4.087 5.571c0.001-0.001 0.002-0.001 0.003-0.002l6.19 5.238C36.971 39.205 44 34 44 24C44 22.659 43.862 21.35 43.611 20.083z"/>
									</svg>
								</div>
							</div>
							<div>
								<div class="font-black text-[#1c2331] text-base">Paulo Mendes</div>
								<div class="text-sm text-gray-500 font-semibold">Morador do Pimentas</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- 3. Bairros de Atuação -->
		<section class="w-[100vw] relative left-[50%] right-[50%] -ml-[50vw] -mr-[50vw] px-6 py-24 bg-white border-b border-gray-100">
			<div class="max-w-6xl mx-auto">
				<div class="text-center mb-10">
					<h2 class="text-3xl md:text-[47px] font-black text-gray-900 mb-4 tracking-tighter">Bairros que <span class="text-green-700">Atendemos</span></h2>
					<p class="text-gray-600 text-base leading-relaxed max-w-3xl mx-auto">Levamos caçambas com rapidez e segurança aos principais bairros de Guarulhos, oferecendo atendimento confiável para obras, reformas e limpezas locais.</p>
				</div>

				<nav aria-label="Principais bairros atendidos">
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						{bairrosAtendidos
							.filter(([slug]) => ['centro', 'cumbica', 'bonsucesso', 'pimentas', 'taboao', 'vila-galvao', 'presidente-dutra', 'bom-clima'].includes(slug))
							.map(([slug, nome]) => (
							<a href={`/bairros/${slug}`} class="w-full rounded-2xl border border-gray-200 bg-gray-50 p-4 flex items-center justify-between gap-4 hover:border-green-700 hover:bg-green-50 transition-colors">
								<div>
