---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const todosServicos = await getCollection('servicos');
const ordemModelos = ['cacamba-4m3', 'cacamba-5m3', 'cacamba-6m3', 'cacamba-7m3', 'cacamba-8m3'];
const modelosDestaque = todosServicos
	.filter((servico) => ordemModelos.includes(servico.id))
	.sort((a, b) => ordemModelos.indexOf(a.id) - ordemModelos.indexOf(b.id));
const solucoesObras = [
	{
		titulo: "Caçamba para reformas residenciais",
		descricao: "Solução para reformas de cozinhas, banheiros, quartos e áreas externas. Nossa equipe orienta sobre a capacidade adequada conforme o volume e o tipo de material produzido.",
		capacidades: ["3 m³", "4 m³", "5 m³"],
		botao: "Ver serviço",
		link: "/servicos/cacamba-para-reformas-residenciais",
		icone: "residencial"
	},
	{
		titulo: "Caçamba para condomínios",
		descricao: "Atendimento planejado para obras em apartamentos, fachadas, garagens e áreas comuns, respeitando os horários, acessos e regras definidos pela administração do condomínio.",
		capacidades: ["4 m³", "5 m³", "6 m³"],
		botao: "Ver serviço",
		link: "/servicos/cacamba-para-condominios",
		icone: "condominio"
	},
	{
		titulo: "Caçamba para construtoras",
		descricao: "Entrega, retirada e substituição programadas para manter o canteiro organizado. Atendemos diferentes etapas da construção conforme a geração de resíduos da obra.",
		capacidades: ["6 m³", "7 m³", "8 m³", "9 m³"],
		botao: "Ver serviço",
		link: "/servicos/cacamba-para-construtoras",
		icone: "construtora"
	},
	{
		titulo: "Caçamba para empresas e galpões",
		descricao: "Locação para reformas, ampliações e manutenções em lojas, indústrias, centros logísticos e galpões, com planejamento para não interromper a operação do estabelecimento.",
		capacidades: ["7 m³", "8 m³", "9 m³", "10 m³"],
		botao: "Ver serviço",
		link: "/servicos/cacamba-para-empresas",
		icone: "empresa"
	},
	{
		titulo: "Caçamba para demolições",
		descricao: "Coleta de concreto, tijolos, blocos, argamassa e outros resíduos permitidos. A capacidade é escolhida considerando o volume e principalmente o peso dos materiais.",
		capacidades: ["6 m³", "7 m³", "8 m³", "9 m³"],
		botao: "Ver serviço",
		link: "/servicos/cacamba-para-demolicoes",
		icone: "demolicao"
	},
	{
		titulo: "Troca programada de caçambas",
		descricao: "Serviço para obras que produzem resíduos continuamente. Organizamos entregas, retiradas e substituições para evitar acúmulo de entulho e paralisações no local.",
		capacidades: ["8 m³", "9 m³", "10 m³", "11 m³", "12 m³"],
		botao: "Solicitar planejamento",
		link: "/servicos/troca-programada-de-cacambas",
		icone: "troca"
	}
];
const bairrosAtendidos = [
	['agua-azul', 'Água Azul'],
	['agua-chata', 'Água Chata'],
	['aracilia', 'Aracília'],
	['bananal', 'Bananal'],
	['bela-vista', 'Bela Vista'],
	['bom-clima', 'Bom Clima'],
	['bonsucesso', 'Bonsucesso'],
	['bosque-maia', 'Bosque Maia'],
	['cabucu', 'Cabuçu'],
	['cabucu-de-cima', 'Cabuçu de Cima'],
	['capelinha', 'Capelinha'],
	['cecap', 'CECAP'],
	['centro', 'Centro'],
	['cocaia', 'Cocaia'],
	['cumbica', 'Cumbica'],
	['fatima', 'Fátima'],
	['fortaleza', 'Fortaleza'],
	['gopouva', 'Gopoúva'],
	['invernada', 'Invernada'],
	['itaim', 'Itaim'],
	['itapegica', 'Itapegica'],
	['jardim-fortaleza', 'Jardim Fortaleza'],
	['jardim-itaim', 'Jardim Itaim'],
	['jardim-paraventi', 'Jardim Paraventi'],
	['jardim-presidente-dutra', 'Jardim Presidente Dutra'],
	['jardim-sao-joao', 'Jardim São João'],
	['jardim-vila-galvao', 'Jardim Vila Galvão'],
	['lavras', 'Lavras'],
	['macedo', 'Macedo'],
	['maia', 'Maia'],
	['mato-das-cobras', 'Mato das Cobras'],
	['monte-carmelo', 'Monte Carmelo'],
