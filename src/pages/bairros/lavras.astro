---
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../data/config';

const title = "Aluguel de Caçamba no Lavras - Obra e Terraplenagem";
const description = "Buscando aluguel de caçamba no Lavras? Frota robusta para entulho e terra, descarte legalizado com CTR e MTR. Solicite orçamento!";
const whatsappLink = `https://wa.me/5511943799889?text=${encodeURIComponent("Olá! Gostaria de um orçamento para aluguel de caçamba no Lavras em Guarulhos.")}`;
const phoneLink = `tel:+5511943799889`;
---

<Layout title={title} description={description}>
    <div class="flex flex-col gap-0 w-full max-w-7xl mx-auto px-4 sm:px-6">

        <!-- 1. Hero da Página de Bairro -->
        <section class="max-w-5xl mx-auto w-full pt-16 pb-12 text-center px-4">
            <span class="inline-block py-1.5 px-4 rounded-full bg-green-700 text-white font-black text-xs mb-6 uppercase tracking-widest shadow-sm">
                Atendimento em Guarulhos
            </span>

            <h1 class="text-4xl md:text-[47px] font-black text-gray-900 mb-6 tracking-tighter leading-tight">
                Aluguel de Caçamba no <span class="text-green-700">Lavras</span>
            </h1>

            <p class="text-lg text-gray-600 leading-relaxed max-w-2xl mx-auto font-medium mb-10">
                Buscando aluguel de caçamba no Lavras? Frota robusta para entulho e terra, descarte legalizado com CTR e MTR. Solicite orçamento!
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center px-8 py-4 bg-green-700 text-white text-base font-black rounded-xl transition-all hover:scale-105 active:scale-95 shadow-xl hover:shadow-green-700/40 gap-2 w-full sm:w-auto">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                    </svg>
                    Orçamento via WhatsApp
                </a>
                <a href="#conteudo" class="inline-flex justify-center items-center px-8 py-4 bg-gray-100 text-gray-900 text-base font-black rounded-xl transition-all hover:bg-gray-200 hover:scale-105 active:scale-95 gap-2 w-full sm:w-auto shadow-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                    Ver Caçambas
                </a>
            </div>
        </section>

        <!-- 2. Three Feature Cards Row -->
        <section class="max-w-6xl mx-auto w-full my-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Card 1 -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-start">
                    <div class="w-10 h-10 rounded-xl bg-green-700 text-white flex items-center justify-center font-black mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.25V3.75m0 3.75h3.75" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Frota Robusta para Terra e Entulho</h3>
                    <p class="text-sm text-gray-600 leading-relaxed font-medium">
                        Caminhões preparados para declives acentuados e vias em fase de pavimentação no bairro Lavras.
                    </p>
                </div>

                <!-- Card 2 -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-start">
                    <div class="w-10 h-10 rounded-xl bg-green-700 text-white flex items-center justify-center font-black mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Descarte 100% Legalizado</h3>
                    <p class="text-sm text-gray-600 leading-relaxed font-medium">
                        Licenciamento SMMA e Cetesb com emissão de CTR e MTR, garantindo proteção contra multas ambientais.
                    </p>
                </div>

                <!-- Card 3 -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-start">
                    <div class="w-10 h-10 rounded-xl bg-green-700 text-white flex items-center justify-center font-black mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Agilidade no Posicionamento</h3>
                    <p class="text-sm text-gray-600 leading-relaxed font-medium">
                        Posicionamento estratégico no melhor ângulo para facilitar o carregamento manual ou retroescavadeiras.
                    </p>
                </div>
            </div>
        </section>

        <!-- 3. Layout de Conteúdo: Duas Colunas (Texto + Sidebar Sticky) -->
        <section id="conteudo" class="max-w-6xl mx-auto w-full py-8 mb-16">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 sm:gap-12 items-start">
                
                <!-- Left Column: White Document Container with 4 Sections -->
                <div class="lg:col-span-2 bg-white rounded-3xl p-6 sm:p-10 border border-gray-100 shadow-sm space-y-12">
                    
                    <!-- Section 1: Intro -->
                    <div>
                        <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight mb-6">
                            Aluguel de Caçamba no Lavras: Estrutura Bruta para a Sua Obra
                        </h2>
                        <p class="text-gray-600 text-base leading-relaxed font-medium mb-4">
                            O bairro Lavras é uma das regiões de Guarulhos que passa por uma intensa fase de expansão habitacional. Com a abertura de amplos loteamentos, chácaras dando lugar a novos condomínios e o forte movimento de autoconstrução, o bairro é um canteiro constante de fundações, cortes de terra e concretagem de lajes. Todo esse processo de nivelamento gera toneladas de resíduos extremamente pesados, como argila, rochas e alvenaria bruta. Para escoar esse volume sem paralisar a sua construção, o aluguel de caçamba no Lavras exige logística especializada e equipamentos de alta resistência.
                        </p>
                        <p class="text-gray-600 text-base leading-relaxed font-medium">
                            Nossa frota de caminhões poli-guindaste é preparada para enfrentar as características topográficas do bairro. Sabemos que o Lavras possui vias com declives acentuados e ruas que ainda estão em fase de pavimentação (terra batida). Nossos motoristas são altamente experientes para manobrar sob essas condições, garantindo que o equipamento seja posicionado no melhor ângulo para facilitar o carregamento manual ou o acesso de retroescavadeiras.
                        </p>
                    </div>

                    <hr class="border-gray-100" />

                    <!-- Section 2: Dumpster Sizes (6 cards) -->
                    <div>
                        <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight mb-3">
                            Qual o Tamanho de Caçamba Ideal para o seu Lote?
                        </h2>
                        <p class="text-gray-600 text-base leading-relaxed font-medium mb-8">
                            Em obras de fundação e terraplenagem, o cálculo incorreto entre volume e densidade pode inviabilizar o içamento do equipamento. Conheça as opções disponíveis e escolha a capacidade certa para a sua demanda no Lavras:
                        </p>

                        <div class="space-y-6">
                            <!-- 4m³ -->
                            <div class="p-5 rounded-2xl border border-gray-100 bg-gray-50/50">
                                <h3 class="text-xl font-black text-gray-900 mb-2"><a href="/servicos/cacamba-4m3" class="hover:text-green-700 hover:underline transition-colors">Caçamba de 4m³</a></h3>
                                <p class="text-gray-600 text-sm leading-relaxed font-medium">
                                    É o equipamento mais robusto e seguro para o início de qualquer obra. Com o tamanho exato de uma vaga de carro de passeio, a caçamba de 4 metros cúbicos é a única recomendada para o descarte de materiais de extrema densidade, como terra de escavação (barro úmido), pedras, asfalto e blocos de concreto maciço. Ela suporta o peso bruto sem comprometer o sistema hidráulico do caminhão.
                                </p>
                            </div>

                            <!-- 5m³ -->
                            <div class="p-5 rounded-2xl border border-gray-100 bg-gray-50/50">
                                <h3 class="text-xl font-black text-gray-900 mb-2"><a href="/servicos/cacamba-5m3" class="hover:text-green-700 hover:underline transition-colors">Caçamba de 5m³</a></h3>
                                <p class="text-gray-600 text-sm leading-relaxed font-medium">
                                    Uma excelente opção intermediária para terrenos que já superaram a fase pesada de nivelamento e entraram na alvenaria estrutural. A caçamba de 5 metros cúbicos acomoda perfeitamente a mistura de entulho denso com resíduos levemente mais volumosos, como pedaços de madeira de tapume, raízes menores, argamassa e restos de tijolos.
                                </p>
                            </div>

                            <!-- 6m³ -->
                            <div class="p-5 rounded-2xl border border-gray-100 bg-gray-50/50">
                                <h3 class="text-xl font-black text-gray-900 mb-2"><a href="/servicos/cacamba-6m3" class="hover:text-green-700 hover:underline transition-colors">Caçamba de 6m³</a></h3>
                                <p class="text-gray-600 text-sm leading-relaxed font-medium">
                                    Projetada especificamente para materiais de peso moderado e alto volume. A caçamba de 6 metros cúbicos é muito utilizada para o descarte de galhadas secas, madeiramento de telhados, plásticos e gesso cartonado. Atenção: Em obras de escavação no Lavras, ela jamais deve ser preenchida até o limite com terra úmida ou argila, sob risco de exceder a tara de segurança do caminhão e inviabilizar a retirada.
                                </p>
                            </div>

                            <!-- 7m³ -->
                            <div class="p-5 rounded-2xl border border-gray-100 bg-gray-50/50">
                                <h3 class="text-xl font-black text-gray-900 mb-2"><a href="/servicos/cacamba-7m3" class="hover:text-green-700 hover:underline transition-colors">Caçamba de 7m³</a></h3>
                                <p class="text-gray-600 text-sm leading-relaxed font-medium">
                                    Este modelo atende de forma estratégica à demanda de pequenas construtoras e loteadoras locais. A caçamba de 7 metros cúbicos possui excelente capacidade interna para o armazenamento de resíduos leves e altamente volumosos da fase de acabamento ou logística, como grandes embalagens, paletes de madeira, sobras de isolamento térmico e canos de PVC longos.
                                </p>
                            </div>

                            <!-- 8m³ -->
                            <div class="p-5 rounded-2xl border border-gray-100 bg-gray-50/50">
                                <h3 class="text-xl font-black text-gray-900 mb-2"><a href="/servicos/cacamba-8m3" class="hover:text-green-700 hover:underline transition-colors">Caçamba de 8m³</a></h3>
                                <p class="text-gray-600 text-sm leading-relaxed font-medium">
                                    A maior entre as caçambas estacionárias convencionais de rua. A versão de 8 metros cúbicos é destinada estritamente a resíduos de volume expansivo e baixíssima densidade. Ela é amplamente locada para a limpeza verde da superfície do lote (folhagens soltas e mato seco) ou para materiais construtivos muito leves, como plásticos expansivos e isopor.
                                </p>
                            </div>

                            <!-- Roll-on -->
                            <div class="p-5 rounded-2xl border border-gray-100 bg-gray-50/50">
                                <h3 class="text-xl font-black text-gray-900 mb-2"><a href="/servicos/cacamba-roll-on" class="hover:text-green-700 hover:underline transition-colors">Caçamba Roll-on</a></h3>
                                <p class="text-gray-600 text-sm leading-relaxed font-medium">
                                    O sistema Roll-on (ou Roll-on Roll-off) é a estrutura definitiva para megaprojetos, galpões e desmatamento autorizado de grandes áreas. Operam como contêineres colossais de 25m³ a 40m³, movimentados por caminhões trucados especiais. São indicadas unicamente para loteamentos que geram dezenas de toneladas de resíduos por dia e que possuam solo firme, plano e espaço amplo para manobras pesadas (não sendo adequadas para vias estreitas e íngremes de terra batida).
                                </p>
                            </div>
                        </div>
                    </div>

                    <hr class="border-gray-100" />

                    <!-- Section 3: Legal Compliance -->
                    <div>
                        <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight mb-6">
                            Descarte 100% Legalizado e Proteção Contra Multas
                        </h2>
                        <p class="text-gray-600 text-base leading-relaxed font-medium mb-4">
                            O despejo clandestino de restos de construção e terra em terrenos baldios ou áreas de vegetação periféricas gera graves problemas ambientais, como enchentes e deslizamentos. A polícia ambiental de Guarulhos é rigorosa, e a multa por descarte irregular recai diretamente sobre o proprietário do terreno.
                        </p>
                        <p class="text-gray-600 text-base leading-relaxed font-medium">
                            Com a nossa equipe, sua obra é blindada juridicamente. Operamos com cadastro ativo e licenciamento da Secretaria Municipal de Meio Ambiente (SMMA) e da Cetesb. Todo o volume retirado do seu lote no Lavras é encaminhado para aterros licenciados e Áreas de Transbordo e Triagem (ATT). Entregamos a você o CTR (Controle de Transporte de Resíduos) e o MTR, atestando a rastreabilidade ecológica do seu entulho.
                        </p>
                    </div>

                    <hr class="border-gray-100" />

                    <!-- Section 4: Safety Rules -->
                    <div>
                        <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight mb-4">
                            Regras de Segurança para Movimentação de Terra
                        </h2>
                        <p class="text-gray-600 text-base leading-relaxed font-medium mb-6">
                            Para garantir um escoamento ágil e evitar acidentes nas vias acidentadas do bairro, siga três orientações:
                        </p>
                        <ul class="space-y-3 text-gray-600 text-base leading-relaxed font-medium pl-2 mb-6">
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong>Distribuição de Peso:</strong> Ao carregar terra e barro, distribua o material uniformemente pela caixa metálica. O peso concentrado de um único lado pode desequilibrar o caminhão durante o içamento.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong>Sem Excesso (Zero "Morrinho"):</strong> A terra jamais deve ultrapassar a borda superior da caçamba. Em ruas com declives, o excesso de barro escorrega fatalmente para o asfalto, causando acidentes de trânsito.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong>Sem Contaminação Orgânica:</strong> O equipamento é exclusivo para resíduos inertes da construção civil (RCC). Lixo doméstico, restos de comida ou produtos químicos inflamáveis contaminam a carga e impedem a reciclagem.</span>
                            </li>
                        </ul>
                        <p class="text-gray-600 text-base leading-relaxed font-medium">
                            Facilite a rotina dos seus pedreiros e garanta a limpeza do seu loteamento. Entre em contato conosco via WhatsApp agora mesmo, conheça nossos pacotes transparentes e agende a locação do seu equipamento!
                        </p>
                    </div>

                </div>

                <!-- Right Column: Sticky Sidebar Card -->
                <aside class="w-full">
                    <div class="sticky top-28 bg-green-700 rounded-3xl p-6 sm:p-8 text-center shadow-2xl shadow-green-700/30 text-white">
                        <span class="inline-block text-xs font-black tracking-widest text-white/90 uppercase mb-4">
                            ORÇAMENTO GRATUITO
                        </span>
                        
                        <h3 class="text-2xl font-black text-white mb-6 leading-tight tracking-tight">
                            Interessado em alugar uma caçamba no Lavras?
                        </h3>

                        <div class="space-y-3 mb-6">
                            <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 w-full py-4 px-6 bg-[#1c2331] text-white font-black text-sm sm:text-base rounded-xl hover:bg-black transition-all hover:scale-[1.02] active:scale-95 shadow-xl">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                                </svg>
                                Pedir no WhatsApp
                            </a>
                            <a href={phoneLink} class="flex items-center justify-center gap-2 w-full py-4 px-6 bg-white text-gray-950 font-black text-sm sm:text-base rounded-xl hover:bg-gray-50 transition-all hover:scale-[1.02] active:scale-95 shadow-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.539-4.239-7.136-7.136l1.292-.97c.363-.271.527-.734.418-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                                </svg>
                                Ligar Agora
                            </a>
                        </div>

                        <p class="text-xs font-bold text-white/80 mb-1">
                            Dúvidas? Fale com nossa equipe:
                        </p>
                        <a href={phoneLink} class="text-xl font-black text-white tracking-tight hover:underline block">
                            (11) 94375-6600
                        </a>
                    </div>
                </aside>

            </div>
        </section>

    </div>
</Layout>
