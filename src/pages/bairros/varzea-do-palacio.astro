---
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../data/config';

const title = "Aluguel de Caçamba na Várzea do Palácio: Logística B2B";
const description = "Aluguel de caçamba na Várzea do Palácio para galpões. Troca contínua, logística B2B e descarte legal com emissão de CTR. Orce já!";
const whatsappLink = `https://wa.me/5511943758808?text=${encodeURIComponent("Olá! Gostaria de um orçamento para aluguel de caçamba na Várzea do Palácio em Guarulhos.")}`;
const phoneLink = `tel:+5511943758808`;
---

<Layout title={title} description={description}>
    <div class="flex flex-col gap-0 w-full max-w-7xl mx-auto px-4 sm:px-6">

        <!-- 1. Hero da Página de Bairro -->
        <section class="max-w-5xl mx-auto w-full pt-16 pb-12 text-center px-4">
            <span class="inline-block py-1.5 px-4 rounded-full bg-green-700 text-white font-black text-xs mb-6 uppercase tracking-widest shadow-sm">
                Atendimento em Guarulhos
            </span>

            <h1 class="text-4xl md:text-[47px] font-black text-gray-900 mb-6 tracking-tighter leading-tight">
                Aluguel de Caçamba na <span class="text-green-700">Várzea do Palácio</span>
            </h1>

            <p class="text-lg text-gray-600 leading-relaxed max-w-2xl mx-auto font-medium mb-10">
                Aluguel de caçamba na Várzea do Palácio para galpões. Troca contínua, logística B2B e descarte legal com emissão de CTR. Orce já!
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center px-8 py-4 bg-green-700 text-white text-base font-black rounded-xl transition-all hover:scale-105 active:scale-95 shadow-xl hover:shadow-green-700/40 gap-2 w-full sm:w-auto">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                    </svg>
                    Orçamento via WhatsApp
                </a>
                <a href="#conteudo" class="inline-flex justify-center items-center px-8 py-4 bg-gray-100 text-gray-900 text-base font-black rounded-xl transition-all hover:bg-gray-200 hover:scale-105 active:scale-95 gap-2 w-full sm:w-auto shadow-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                    Ver Caçambas
                </a>
            </div>
        </section>

        <!-- 2. Three Feature Cards Row -->
        <section class="max-w-6xl mx-auto w-full my-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Card 1 -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-start">
                    <div class="w-10 h-10 rounded-xl bg-green-700 text-white flex items-center justify-center font-black mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.25V3.75m0 3.75h3.75" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Logística Pesada & B2B</h3>
                    <p class="text-sm text-gray-600 leading-relaxed font-medium">
                        Atendimento ágil para galpões e indústrias às margens da Dutra e Ayrton Senna.
                    </p>
                </div>

                <!-- Card 2 -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-start">
                    <div class="w-10 h-10 rounded-xl bg-green-700 text-white flex items-center justify-center font-black mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Sistema Bate e Volta</h3>
                    <p class="text-sm text-gray-600 leading-relaxed font-medium">
                        Troca contínua programada para docas e canteiros operacionais sem paralisações.
                    </p>
                </div>

                <!-- Card 3 -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-start">
                    <div class="w-10 h-10 rounded-xl bg-green-700 text-white flex items-center justify-center font-black mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Rastreabilidade Total</h3>
                    <p class="text-sm text-gray-600 leading-relaxed font-medium">
                        Descarte em conformidade ambiental com emissão de CTR e MTR para auditorias ISO 14001.
                    </p>
                </div>
            </div>
        </section>

        <!-- 3. Layout de Conteúdo: Duas Colunas (Texto + Sidebar Sticky) -->
        <section id="conteudo" class="max-w-6xl mx-auto w-full py-8 mb-16">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 sm:gap-12 items-start">
                
                <!-- Left Column: White Document Container with 4 Sections -->
                <div class="lg:col-span-2 bg-white rounded-3xl p-6 sm:p-10 border border-gray-100 shadow-sm space-y-12">
                    
                    <!-- Section 1: Intro -->
                    <div>
                        <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight mb-6">
                            Aluguel de Caçamba na Várzea do Palácio: Logística Pesada para a Indústria
                        </h2>
                        <p class="text-gray-600 text-base leading-relaxed font-medium mb-4">
                            O bairro Várzea do Palácio é um dos polos industriais e logísticos mais estratégicos e representativos de Guarulhos. Localizado às margens do Rio Tietê e com acesso direto a corredores rodoviários vitais (Rodovia Ayrton Senna e Presidente Dutra), a região é dominada por galpões de grande porte, empresas de transporte, centros de distribuição e depósitos. Nesse ambiente estritamente corporativo, intervenções na infraestrutura envolvem quebras maciças de lajes fabris, adequações de pátios para empilhadeiras e obras de expansão. Para suportar esse ritmo produtivo acelerado, o aluguel de caçamba na Várzea do Palácio exige maquinário pesado, trocas programadas e rigor absoluto no cumprimento das normas ambientais.
                        </p>
                        <p class="text-gray-600 text-base leading-relaxed font-medium">
                            Em um cenário onde uma doca de carregamento obstruída representa atrasos e prejuízos diretos, oferecemos o sistema de troca contínua (bate e volta): assim que a caçamba atinge a sua capacidade máxima, nosso caminhão poli-guindaste realiza a remoção e posiciona uma caixa vazia imediatamente no local. Nossas caçambas industriais são fabricadas em aço reforçado, suportando toneladas de concreto sem deformações, mantendo o chão de fábrica da sua empresa sempre limpo e operacional.
                        </p>
                    </div>

                    <hr class="border-gray-100" />

                    <!-- Section 2: Dumpster Sizes (6 cards) -->
                    <div>
                        <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight mb-3">
                            Qual o Tamanho de Caçamba Ideal para a Sua Planta Fabril?
                        </h2>
                        <p class="text-gray-600 text-base leading-relaxed font-medium mb-8">
                            No setor B2B, dimensionar corretamente a capacidade do equipamento é vital para otimizar o fluxo de resíduos e evitar a sobrecarga dos caminhões. Conheça as opções para a demanda industrial da Várzea do Palácio:
                        </p>

                        <div class="space-y-6">
                            <!-- 4m³ -->
                            <div class="p-5 rounded-2xl border border-gray-100 bg-gray-50/50">
                                <h3 class="text-xl font-black text-gray-900 mb-2"><a href="/servicos/cacamba-4m3" class="hover:text-green-700 hover:underline transition-colors">Caçamba de 4m³</a></h3>
                                <p class="text-gray-600 text-sm leading-relaxed font-medium">
                                    O equipamento mais denso e resistente da frota estacionária. Com as dimensões de uma vaga veicular, a caçamba de 4 metros cúbicos é a única recomendada para o descarte de materiais industriais de peso extremo, como asfalto fresado dos pátios de manobra, blocos maciços de fundação, restos de lajes usinadas e terra, suportando a tara bruta com total segurança durante o içamento.
                                </p>
                            </div>

                            <!-- 5m³ -->
                            <div class="p-5 rounded-2xl border border-gray-100 bg-gray-50/50">
                                <h3 class="text-xl font-black text-gray-900 mb-2"><a href="/servicos/cacamba-5m3" class="hover:text-green-700 hover:underline transition-colors">Caçamba de 5m³</a></h3>
                                <p class="text-gray-600 text-sm leading-relaxed font-medium">
                                    Uma excelente opção intermediária para adequações de escritórios internos ou reestruturações de galpões menores. A caçamba de 5 metros cúbicos acomoda de forma eficiente a mistura de entulho estrutural com resíduos levemente mais volumosos, como pedaços de madeira, estruturas metálicas de pequeno porte, encanamentos industriais e portas descartadas.
                                </p>
                            </div>

                            <!-- 6m³ -->
                            <div class="p-5 rounded-2xl border border-gray-100 bg-gray-50/50">
                                <h3 class="text-xl font-black text-gray-900 mb-2"><a href="/servicos/cacamba-6m3" class="hover:text-green-700 hover:underline transition-colors">Caçamba de 6m³</a></h3>
                                <p class="text-gray-600 text-sm leading-relaxed font-medium">
                                    Projetada especificamente para o descarte de alto volume e peso moderado. A caçamba de 6 metros cúbicos é muito utilizada para reformas nas alas administrativas e refeitórios das fábricas, acondicionando placas de gesso cartonado (drywall), forros, plásticos e embalagens. Para evitar o travamento do sistema hidráulico, jamais deve ser preenchida até o limite com concreto puro da fábrica.
                                </p>
                            </div>

                            <!-- 7m³ -->
                            <div class="p-5 rounded-2xl border border-gray-100 bg-gray-50/50">
                                <h3 class="text-xl font-black text-gray-900 mb-2"><a href="/servicos/cacamba-7m3" class="hover:text-green-700 hover:underline transition-colors">Caçamba de 7m³</a></h3>
                                <p class="text-gray-600 text-sm leading-relaxed font-medium">
                                    Este modelo é a escolha estratégica para os grandes centros de distribuição e transportadoras da região. A caçamba de 7 metros cúbicos possui excelente capacidade para resíduos logísticos leves e muito volumosos, como paletes de madeira avariados, grandes caixas de papelão, sobras de isolamento térmico e tubulações, reduzindo a frequência de locações.
                                </p>
                            </div>

                            <!-- 8m³ -->
                            <div class="p-5 rounded-2xl border border-gray-100 bg-gray-50/50">
                                <h3 class="text-xl font-black text-gray-900 mb-2"><a href="/servicos/cacamba-8m3" class="hover:text-green-700 hover:underline transition-colors">Caçamba de 8m³</a></h3>
                                <p class="text-gray-600 text-sm leading-relaxed font-medium">
                                    A maior entre as caçambas estacionárias convencionais. A versão de 8 metros cúbicos é destinada estritamente a resíduos de volume expansivo e baixíssima densidade. É a solução perfeita para escoar materiais fabris levíssimos, como espumas industriais, isopor de proteção de cargas, plásticos expansivos e refugo de embalagens limpas.
                                </p>
                            </div>

                            <!-- Roll-on -->
                            <div class="p-5 rounded-2xl border border-gray-100 bg-gray-50/50">
                                <h3 class="text-xl font-black text-gray-900 mb-2"><a href="/servicos/cacamba-roll-on" class="hover:text-green-700 hover:underline transition-colors">Caçamba Roll-on</a></h3>
                                <p class="text-gray-600 text-sm leading-relaxed font-medium">
                                    O sistema Roll-on (ou Roll-on Roll-off) é o equipamento definitivo para a Várzea do Palácio. Operando com caminhões trucados superpesados e contêineres colossais de 25m³ a 40m³, são a estrutura principal para megaprojetos, terraplenagem industrial e demolições totais de galpões. Como o bairro oferece amplo espaço de recuo, docas e pátios de manobra concretados, o Roll-on é a escolha de melhor custo-benefício para plantas que geram dezenas de toneladas de resíduos por semana.
                                </p>
                            </div>
                        </div>
                    </div>

                    <hr class="border-gray-100" />

                    <!-- Section 3: Legal Compliance -->
                    <div>
                        <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight mb-6">
                            Compliance Ambiental B2B: Certificações e Emissão de CTR
                        </h2>
                        <p class="text-gray-600 text-base leading-relaxed font-medium mb-4">
                            Indústrias multinacionais e operadores logísticos instalados na Várzea do Palácio respondem a auditorias rigorosas e a metas de sustentabilidade corporativa (como a certificação ISO 14001). A contratação de transportadores sem licença ambiental é um risco que pode resultar em embargos, suspensão de alvarás e multas milionárias aplicadas ao CNPJ da geradora.
                        </p>
                        <p class="text-gray-600 text-base leading-relaxed font-medium">
                            Nossa empresa atua como a parceira logística e legal da sua engenharia. Somos integralmente licenciados pela Secretaria Municipal de Meio Ambiente (SMMA) e pela Cetesb. Todo o entulho classe A, B e C retirado do seu galpão é rastreado e direcionado para aterros de inertes e centros de triagem homologados. Para resguardar o seu CNPJ em qualquer auditoria, entregamos pontualmente o MTR e o CTR (Controle de Transporte de Resíduos), garantindo transparência e rastreabilidade total.
                        </p>
                    </div>

                    <hr class="border-gray-100" />

                    <!-- Section 4: Safety Rules -->
                    <div>
                        <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight mb-4">
                            Regras Críticas para o Descarte no Setor Industrial
                        </h2>
                        <p class="text-gray-600 text-base leading-relaxed font-medium mb-6">
                            No ambiente corporativo, a gestão correta na fonte é inegociável. Para mantermos a excelência e a segurança viária nas rodovias vizinhas (Dutra e Ayrton Senna), atente-se às normas operacionais:
                        </p>
                        <ul class="space-y-3 text-gray-600 text-base leading-relaxed font-medium pl-2 mb-6">
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong>Controle Rigoroso de Carga (Sem Excesso):</strong> A carga jamais pode ultrapassar as bordas de aço da caçamba ou do contêiner Roll-on. O derramamento de materiais pesados nas marginais de Guarulhos gera acidentes graves e responsabilização direta da empresa geradora.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong>Proibição Absoluta de Resíduos Perigosos (Classe I):</strong> Nossos equipamentos destinam-se a resíduos da construção civil. É terminantemente proibido o descarte de lixo químico industrial, estopas contaminadas com óleo, graxas, borras de solventes ou tintas líquidas.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong>Pátio de Docas Acessível:</strong> Reserve e isole a área de estacionamento da caçamba, mantendo a rota livre de carretas, caminhões em doca ou pilhas de pallets no horário agendado, permitindo que nosso poli-guindaste ou caminhão Roll-on manobre com agilidade.</span>
                            </li>
                        </ul>
                        <p class="text-gray-600 text-base leading-relaxed font-medium">
                            Fornecemos faturamento corporativo, contratos sob medida e suporte flexível. Entre em contato direto com nossos consultores B2B via WhatsApp, alinhe a demanda da sua indústria na Várzea do Palácio e desenhe a melhor logística de remoção de resíduos para a sua operação!
                        </p>
                    </div>

                </div>

                <!-- Right Column: Sticky Sidebar Card -->
                <aside class="w-full">
                    <div class="sticky top-28 bg-green-700 rounded-3xl p-6 sm:p-8 text-center shadow-2xl shadow-green-700/30 text-white">
                        <span class="inline-block text-xs font-black tracking-widest text-white/90 uppercase mb-4">
                            ORÇAMENTO GRATUITO
                        </span>
                        
                        <h3 class="text-2xl font-black text-white mb-6 leading-tight tracking-tight">
                            Interessado em alugar uma caçamba na Várzea do Palácio?
                        </h3>

                        <div class="space-y-3 mb-6">
                            <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 w-full py-4 px-6 bg-[#1c2331] text-white font-black text-sm sm:text-base rounded-xl hover:bg-black transition-all hover:scale-[1.02] active:scale-95 shadow-xl">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                                </svg>
                                Pedir no WhatsApp
                            </a>
                            <a href={phoneLink} class="flex items-center justify-center gap-2 w-full py-4 px-6 bg-white text-gray-950 font-black text-sm sm:text-base rounded-xl hover:bg-gray-50 transition-all hover:scale-[1.02] active:scale-95 shadow-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.539-4.239-7.136-7.136l1.292-.97c.363-.271.527-.734.418-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                                </svg>
                                Ligar Agora
                            </a>
                        </div>

                        <p class="text-xs font-bold text-white/80 mb-1">
                            Dúvidas? Fale com nossa equipe:
                        </p>
                        <a href={phoneLink} class="text-xl font-black text-white tracking-tight hover:underline block">
                            (11) 94375-8808
                        </a>
                    </div>
                </aside>

            </div>
        </section>

    </div>
</Layout>
