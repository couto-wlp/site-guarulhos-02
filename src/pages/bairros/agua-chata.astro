---
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../data/config';

const title = "Aluguel de Caçamba no Água Chata - Entrega Rápida";
const description = "Aluguel de caçamba no Água Chata para obras e indústrias. Descarte 100% legal, emissão de MTR e troca rápida. Peça o seu orçamento!";
const whatsappLink = `https://wa.me/5511943799889?text=${encodeURIComponent("Olá! Gostaria de um orçamento para aluguel de caçamba no bairro Água Chata em Guarulhos.")}`;
const phoneLink = `tel:+5511943799889`;
---

<Layout title={title} description={description}>
    <div class="flex flex-col gap-0 w-full max-w-7xl mx-auto px-4 sm:px-6">

        <!-- 1. Hero da Página de Bairro -->
        <section class="max-w-5xl mx-auto w-full pt-16 pb-12 text-center px-4">
            <span class="inline-block py-1.5 px-4 rounded-full bg-green-700 text-white font-black text-xs mb-6 uppercase tracking-widest shadow-sm">
                Atendimento em Guarulhos
            </span>

            <h1 class="text-4xl md:text-[47px] font-black text-gray-900 mb-6 tracking-tighter leading-tight">
                Aluguel de Caçamba no <span class="text-green-700">Água Chata</span>
            </h1>

            <p class="text-lg text-gray-600 leading-relaxed max-w-2xl mx-auto font-medium mb-10">
                Aluguel de caçamba no Água Chata para obras e indústrias. Descarte 100% legal, emissão de MTR e troca rápida. Peça o seu orçamento!
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center px-8 py-4 bg-green-700 text-white text-base font-black rounded-xl transition-all hover:scale-105 active:scale-95 shadow-xl hover:shadow-green-700/40 gap-2 w-full sm:w-auto">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                    </svg>
                    Orçamento via WhatsApp
                </a>
                <a href="#conteudo" class="inline-flex justify-center items-center px-8 py-4 bg-gray-100 text-gray-900 text-base font-black rounded-xl transition-all hover:bg-gray-200 hover:scale-105 active:scale-95 gap-2 w-full sm:w-auto shadow-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                    Ver Caçambas
                </a>
            </div>
        </section>

        <!-- 2. Three Feature Cards Row -->
        <section class="max-w-6xl mx-auto w-full my-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Card 1 -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-start">
                    <div class="w-10 h-10 rounded-xl bg-green-700 text-white flex items-center justify-center font-black mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Logística Expressa</h3>
                    <p class="text-sm text-gray-600 leading-relaxed font-medium">
                        Entrega e remoção rápidas e pontuais no bairro Água Chata, atendendo ao cronograma de sua construção ou indústria.
                    </p>
                </div>

                <!-- Card 2 -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-start">
                    <div class="w-10 h-10 rounded-xl bg-green-700 text-white flex items-center justify-center font-black mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Descarte 100% Legal</h3>
                    <p class="text-sm text-gray-600 leading-relaxed font-medium">
                        Emissão completa de MTR e CTR, em conformidade com as normas da Secretaria Municipal do Meio Ambiente (SMMA) de Guarulhos.
                    </p>
                </div>

                <!-- Card 3 -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-start">
                    <div class="w-10 h-10 rounded-xl bg-green-700 text-white flex items-center justify-center font-black mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Posicionamento Seguro</h3>
                    <p class="text-sm text-gray-600 leading-relaxed font-medium">
                        Motoristas experientes que posicionam a caçamba de forma regularizada na rua ou no pátio da sua empresa no Água Chata.
                    </p>
                </div>
            </div>
        </section>

        <!-- 3. Main Two-Column Content (Left: Document / Right: Sticky Sidebar Card) -->
        <section id="conteudo" class="max-w-6xl mx-auto w-full my-8 pb-16">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-10 items-start">

                <!-- Left Column: Content Container -->
                <div class="lg:col-span-2 bg-white rounded-3xl p-8 sm:p-12 border border-gray-100 shadow-sm space-y-10">

                    <!-- Section 1 -->
                    <div>
                        <h2 class="text-2xl sm:text-[26px] font-black text-gray-900 mb-4 tracking-tight">
                            Aluguel de Caçamba no Água Chata: Solução Completa para Obras e Indústrias
                        </h2>
                        <div class="space-y-4 text-gray-600 text-base leading-relaxed font-medium">
                            <p>
                                Se você está gerenciando uma construção, reforma residencial ou coordenando a manutenção de um galpão logístico, o aluguel de caçamba no Água Chata é a solução definitiva para o descarte correto de resíduos. O bairro de Água Chata, em Guarulhos, possui uma dinâmica única, misturando o constante crescimento residencial com um forte polo industrial. Por isso, oferecemos um serviço de locação ágil, seguro e totalmente alinhado às normas ambientais.
                            </p>
                            <p>
                                Nossa logística expressa garante que a entrega e a retirada do equipamento ocorram dentro do seu cronograma, evitando atrasos na sua obra. Trabalhamos com motoristas altamente experientes, garantindo o posicionamento seguro e legalizado da caçamba nas vias do bairro.
                            </p>
                        </div>
                    </div>

                    <!-- Section 2 -->
                    <div>
                        <h2 class="text-2xl sm:text-[26px] font-black text-gray-900 mb-4 tracking-tight">
                            Qual o Tamanho Ideal de Caçamba para a sua Necessidade?
                        </h2>
                        <p class="text-gray-600 text-base leading-relaxed font-medium mb-4">
                            Entender o volume de resíduos gerados é fundamental para otimizar os custos da sua obra. Abaixo, detalhamos as opções disponíveis para atender desde pequenas reformas até grandes complexos industriais:
                        </p>
                        <ul class="space-y-4 text-gray-600 text-base leading-relaxed font-medium pl-2">
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong><a href="/servicos/cacamba-4m3" class="text-green-700 hover:underline">Caçamba de 4m³</a>:</strong> Este é o modelo mais tradicional e amplamente utilizado em reformas residenciais e pequenas obras. A caçamba de 4 metros cúbicos é perfeita para o descarte de entulhos pesados, como restos de alvenaria, pisos, azulejos, terra e argamassa. Devido ao seu tamanho compacto, ela ocupa o espaço equivalente ao de um carro de passeio, facilitando o estacionamento em ruas residenciais sem atrapalhar o trânsito local.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong><a href="/servicos/cacamba-5m3" class="text-green-700 hover:underline">Caçamba de 5m³</a>:</strong> Uma excelente opção intermediária para obras de médio porte ou limpezas gerais. Ela oferece um metro cúbico a mais de capacidade em relação ao modelo padrão, sendo ideal para acomodar misturas de entulho pesado com materiais um pouco mais volumosos, como pedaços de gesso, restos de madeira, portas antigas e recortes de drywall de reformas comerciais.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong><a href="/servicos/cacamba-6m3" class="text-green-700 hover:underline">Caçamba de 6m³</a>:</strong> Projetada especificamente para resíduos mais volumosos e de peso moderado, a caçamba de 6 metros cúbicos é muito solicitada para o descarte de podas de árvores, restos de forro, gesso, plásticos e madeiras de construções. É importante ressaltar que ela não deve ser totalmente preenchida com materiais extremamente densos (como terra pura ou concreto) para não ultrapassar o limite de peso do caminhão guindaste.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong><a href="/servicos/cacamba-7m3" class="text-green-700 hover:underline">Caçamba de 7m³</a>:</strong> Este tamanho atende perfeitamente indústrias, galpões e construtoras que geram uma quantidade significativa de lixo não compactável. A caçamba de 7 metros cúbicos é a escolha certa para descartar grandes embalagens, pallets quebrados, sobras de isolamento térmico e outros resíduos industriais leves, otimizando a logística de retirada ao exigir menos trocas durante a semana.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong><a href="/servicos/cacamba-8m3" class="text-green-700 hover:underline">Caçamba de 8m³</a>:</strong> Sendo a maior entre as caçambas estacionárias tradicionais, a versão de 8 metros cúbicos é voltada exclusivamente para materiais de grande volume e baixíssima densidade. Ela é amplamente utilizada em limpezas de grandes terrenos (para descarte de mato e galhadas volumosas) ou em fábricas que precisam escoar resíduos leves, como espumas, plásticos expansivos e papelão em grande escala, garantindo o melhor custo-benefício por viagem.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong><a href="/servicos/cacamba-roll-on" class="text-green-700 hover:underline">Caçamba Roll-on</a>:</strong> O sistema Roll-on (ou Roll-on Roll-off) é a solução definitiva para megaprojetos, demolições completas e indústrias de grande porte. Essas caçambas possuem capacidades que variam geralmente entre 25m³ e 40m³ e são transportadas por caminhões trucados especiais. Elas funcionam como verdadeiros contêineres e são indicadas para canteiros de obras que possuem espaço amplo para manobra e geram toneladas de resíduos diariamente, necessitando de uma remoção em escala industrial.</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Section 3 -->
                    <div>
                        <h2 class="text-2xl sm:text-[26px] font-black text-gray-900 mb-4 tracking-tight">
                            Descarte 100% Legalizado e Compromisso Ambiental
                        </h2>
                        <div class="space-y-4 text-gray-600 text-base leading-relaxed font-medium">
                            <p>
                                A autoridade no setor de transporte de entulho se faz com transparência e responsabilidade. Ao contratar nosso aluguel de caçamba no Água Chata, você tem a garantia de que nenhum resíduo será descartado de forma clandestina.
                            </p>
                            <p>
                                Trabalhamos em total conformidade com a Secretaria Municipal de Meio Ambiente (SMMA) de Guarulhos. Todo o material recolhido passa por triagem: o que é reciclável é destinado a usinas de reciclagem da construção civil (gerando brita e areia reciclada), e o rejeito vai para aterros licenciados. Fornecemos o MTR (Manifesto de Transporte de Resíduos) e a CTR (Controle de Transporte de Resíduos), documentos essenciais para a auditoria ambiental de indústrias e construtoras.
                            </p>
                        </div>
                    </div>

                    <!-- Section 4 -->
                    <div>
                        <h2 class="text-2xl sm:text-[26px] font-black text-gray-900 mb-4 tracking-tight">
                            Regras de Segurança e Posicionamento na Via
                        </h2>
                        <div class="space-y-4 text-gray-600 text-base leading-relaxed font-medium">
                            <p>
                                Para garantir a segurança no trânsito e evitar multas, nossas caçambas são estacionadas paralelamente à guia, seguindo rigorosamente as leis de trânsito. É estritamente proibido posicionar o equipamento sobre bueiros, guias rebaixadas, pontos de ônibus ou faixas de pedestres. Além disso, lembramos que caçambas de entulho não podem receber lixo orgânico, resíduos hospitalares, telhas de amianto, tintas frescas ou produtos químicos inflamáveis.
                            </p>
                            <p>
                                Trabalhar com uma empresa profissional elimina os riscos de multas e dores de cabeça com a fiscalização. Agende agora a sua locação e mantenha sua obra limpa e regularizada!
                            </p>
                        </div>
                    </div>

                </div>

                <!-- Right Column: Sticky Sidebar Card -->
                <aside class="w-full">
                    <div class="sticky top-28 bg-green-700 rounded-3xl p-6 sm:p-8 text-center shadow-2xl shadow-green-700/30 text-white">
                        <span class="inline-block text-xs font-black tracking-widest text-white/90 uppercase mb-4">
                            ORÇAMENTO GRATUITO
                        </span>
                        
                        <h3 class="text-2xl font-black text-white mb-6 leading-tight tracking-tight">
                            Interessado em alugar uma caçamba no Água Chata?
                        </h3>

                        <div class="space-y-3 mb-6">
                            <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 w-full py-4 px-6 bg-[#1c2331] text-white font-black text-sm sm:text-base rounded-xl hover:bg-black transition-all hover:scale-[1.02] active:scale-95 shadow-xl">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                                </svg>
                                Pedir no WhatsApp
                            </a>
                            <a href={phoneLink} class="flex items-center justify-center gap-2 w-full py-4 px-6 bg-white text-gray-950 font-black text-sm sm:text-base rounded-xl hover:bg-gray-50 transition-all hover:scale-[1.02] active:scale-95 shadow-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.539-4.239-7.136-7.136l1.292-.97c.363-.271.527-.734.418-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                                </svg>
                                Ligar Agora
                            </a>
                        </div>

                        <p class="text-xs font-bold text-white/80 mb-1">
                            Dúvidas? Fale com nossa equipe:
                        </p>
                        <a href={phoneLink} class="text-xl font-black text-white tracking-tight hover:underline block">
                            (11) 94375-6600
                        </a>
                    </div>
                </aside>

            </div>
        </section>

    </div>
</Layout>
