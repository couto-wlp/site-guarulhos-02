---
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../data/config';

const title = "Aluguel de Caçamba no Jardim Vila Galvão - Rápido";
const description = "Buscando aluguel de caçamba no Jardim Vila Galvão? Remoção de entulho ágil, descarte legal e emissão de CTR e MTR. Orce agora!";
