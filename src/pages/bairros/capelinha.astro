---
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../data/config';

const title = "Aluguel de Caçamba no Capelinha - Rápido e Seguro";
const description = "Buscando aluguel de caçamba no Capelinha? Oferecemos descarte legalizado, MTR e entrega expressa para sua obra. Peça seu orçamento!";
const whatsappLink = `https://wa.me/5511943758808?text=${encodeURIComponent("Olá! Gostaria de um orçamento para aluguel de caçamba no bairro Capelinha em Guarulhos.")}`;
const phoneLink = `tel:+5511943758808`;
---

<Layout title={title} description={description}>
    <div class="flex flex-col gap-0 w-full max-w-7xl mx-auto px-4 sm:px-6">

        <!-- 1. Hero da Página de Bairro -->
        <section class="max-w-5xl mx-auto w-full pt-16 pb-12 text-center px-4">
            <span class="inline-block py-1.5 px-4 rounded-full bg-green-700 text-white font-black text-xs mb-6 uppercase tracking-widest shadow-sm">
                Atendimento em Guarulhos
            </span>

            <h1 class="text-4xl md:text-[47px] font-black text-gray-900 mb-6 tracking-tighter leading-tight">
                Aluguel de Caçamba no <span class="text-green-700">Capelinha</span>
            </h1>

            <p class="text-lg text-gray-600 leading-relaxed max-w-2xl mx-auto font-medium mb-10">
                Buscando aluguel de caçamba no Capelinha? Oferecemos descarte legalizado, MTR e entrega expressa para sua obra. Peça seu orçamento!
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center px-8 py-4 bg-green-700 text-white text-base font-black rounded-xl transition-all hover:scale-105 active:scale-95 shadow-xl hover:shadow-green-700/40 gap-2 w-full sm:w-auto">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                    </svg>
                    Orçamento via WhatsApp
                </a>
                <a href="#conteudo" class="inline-flex justify-center items-center px-8 py-4 bg-gray-100 text-gray-900 text-base font-black rounded-xl transition-all hover:bg-gray-200 hover:scale-105 active:scale-95 gap-2 w-full sm:w-auto shadow-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                    Ver Caçambas
                </a>
            </div>
        </section>

        <!-- 2. Three Feature Cards Row -->
        <section class="max-w-6xl mx-auto w-full my-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Card 1 -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-start">
                    <div class="w-10 h-10 rounded-xl bg-green-700 text-white flex items-center justify-center font-black mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Logística Expressa</h3>
                    <p class="text-sm text-gray-600 leading-relaxed font-medium">
                        Entrega e retirada ágeis e pontuais no Capelinha, mantendo as vias e calçadas desobstruídas.
                    </p>
                </div>

                <!-- Card 2 -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-start">
                    <div class="w-10 h-10 rounded-xl bg-green-700 text-white flex items-center justify-center font-black mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Descarte 100% Legal</h3>
                    <p class="text-sm text-gray-600 leading-relaxed font-medium">
                        Emissão de CTR e MTR, conformidade com a SMMA e Cetesb e destinação a ATTs certificadas.
                    </p>
                </div>

                <!-- Card 3 -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-start">
                    <div class="w-10 h-10 rounded-xl bg-green-700 text-white flex items-center justify-center font-black mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Orçamento Transparente</h3>
                    <p class="text-sm text-gray-600 leading-relaxed font-medium">
                        Preços justos e sem taxas ocultas para reformas residenciais e comércios do Capelinha.
                    </p>
                </div>
            </div>
        </section>

        <!-- 3. Main Two-Column Content (Left: Document / Right: Sticky Sidebar Card) -->
        <section id="conteudo" class="max-w-6xl mx-auto w-full my-8 pb-16">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-10 items-start">

                <!-- Left Column: Content Container -->
                <div class="lg:col-span-2 bg-white rounded-3xl p-8 sm:p-12 border border-gray-100 shadow-sm space-y-10">

                    <!-- Section 1 -->
                    <div>
                        <h2 class="text-2xl sm:text-[26px] font-black text-gray-900 mb-4 tracking-tight">
                            Aluguel de Caçamba no Capelinha: Agilidade e Descarte Legal para Sua Obra
                        </h2>
                        <div class="space-y-4 text-gray-600 text-base leading-relaxed font-medium">
                            <p>
                                O bairro Capelinha é uma região dinâmica de Guarulhos, onde residências familiares tradicionais, novos sobrados e um comércio ativo dividem o mesmo espaço. Com esse crescimento contínuo, reformas e construções fazem parte do dia a dia da comunidade. No entanto, o entulho gerado por essas obras não pode se tornar um obstáculo nas calçadas e vias estreitas. É nesse cenário que o nosso serviço de aluguel de caçamba no Capelinha se destaca, entregando uma solução logística rápida, segura e totalmente regularizada para o seu quebra-quebra.
                            </p>
                            <p>
                                Evite reclamações de vizinhos, calçadas bloqueadas e o prejuízo no acesso aos comércios locais. Com a nossa frota dedicada, entregamos a caçamba no momento exato em que sua reforma exige e realizamos a retirada de forma ágil, garantindo que o seu cronograma flua perfeitamente.
                            </p>
                        </div>
                    </div>

                    <!-- Section 2 -->
                    <div>
                        <h2 class="text-2xl sm:text-[26px] font-black text-gray-900 mb-4 tracking-tight">
                            Qual o Tamanho de Caçamba Ideal para a Sua Necessidade?
                        </h2>
                        <p class="text-gray-600 text-base leading-relaxed font-medium mb-4">
                            O sucesso da gestão de resíduos da sua obra depende da escolha correta do equipamento. Dimensionar bem o volume evita custos com viagens extras e garante a segurança no transporte. Confira as opções que disponibilizamos para o bairro Capelinha:
                        </p>
                        <ul class="space-y-4 text-gray-600 text-base leading-relaxed font-medium pl-2">
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong><a href="/servicos/cacamba-4m3" class="text-green-700 hover:underline">Caçamba de 4m³</a>:</strong> Este é o equipamento padrão, sendo o mais locado para reformas residenciais e pequenas adequações comerciais. Com o tamanho equivalente ao de uma vaga de carro popular, a caçamba de 4 metros cúbicos é perfeita para o descarte de resíduos pesados e de alta densidade, como restos de alvenaria, concreto, tijolos, terra e azulejos, permitindo que o caminhão faça o içamento sem risco de sobrecarga.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong><a href="/servicos/cacamba-5m3" class="text-green-700 hover:underline">Caçamba de 5m³</a>:</strong> Uma excelente opção intermediária para quem precisa de um volume extra na remoção de entulho. A caçamba de 5 metros cúbicos acomoda de forma ideal a mistura comum de obras civis: resíduos pesados associados a materiais levemente mais volumosos, como pedaços de gesso, recortes de madeira, portas velhas e tubulações antigas.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong><a href="/servicos/cacamba-6m3" class="text-green-700 hover:underline">Caçamba de 6m³</a>:</strong> Estrategicamente projetada para receber materiais de peso moderado, mas com alto volume. A caçamba de 6 metros cúbicos é a escolha certa para descartar grandes quantidades de gesso cartonado (drywall), forros de PVC, embalagens plásticas e podas de árvores do quintal. Para não danificar o sistema hidráulico do caminhão, ela nunca deve ser preenchida até o limite apenas com terra ou concreto puro.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong><a href="/servicos/cacamba-7m3" class="text-green-700 hover:underline">Caçamba de 7m³</a>:</strong> Este modelo atende perfeitamente à demanda de comércios locais, pequenos galpões e construtoras. A caçamba de 7 metros cúbicos possui amplo espaço interno para o armazenamento de resíduos leves e altamente volumosos, como grandes caixas de embalagens, paletes de madeira quebrados, sobras de isolamento térmico e rolos de papelão, otimizando a logística de remoção.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong><a href="/servicos/cacamba-8m3" class="text-green-700 hover:underline">Caçamba de 8m³</a>:</strong> A maior entre as caçambas estacionárias de rua convencionais. A versão de 8 metros cúbicos é voltada estritamente para materiais de altíssimo volume e baixíssima densidade. Ela é muito utilizada para a limpeza rápida de terrenos (remoção de folhagens e galhos) ou descarte de materiais comerciais levíssimos, como plásticos expansivos, isopor e espumas.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong><a href="/servicos/cacamba-roll-on" class="text-green-700 hover:underline">Caçamba Roll-on</a>:</strong> O sistema Roll-on (ou Roll-on Roll-off) é a estrutura definitiva para grandes demolições e megaprojetos estruturais. Operando como contêineres gigantes, essas caçambas possuem capacidades colossais que variam de 25m³ a 40m³. São indicadas unicamente para canteiros de obras industriais que geram toneladas de resíduos diariamente e que dispõem de espaço físico amplo para as manobras dos caminhões trucados.</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Section 3 -->
                    <div>
                        <h2 class="text-2xl sm:text-[26px] font-black text-gray-900 mb-4 tracking-tight">
                            Segurança Jurídica: Descarte 100% Legalizado e Sustentável
                        </h2>
                        <div class="space-y-4 text-gray-600 text-base leading-relaxed font-medium">
                            <p>
                                A prefeitura de Guarulhos possui regras rígidas sobre o descarte de Resíduos da Construção Civil (RCC). Entregar seu entulho a transportadores clandestinos é um erro que pode custar caro: se o material for despejado irregularmente, a multa ambiental recai sobre você, o gerador do resíduo.
                            </p>
                            <p>
                                Ao contratar nosso aluguel de caçamba no Capelinha, você tem total segurança jurídica. Somos licenciados pela Secretaria Municipal de Meio Ambiente (SMMA) e operamos sob as diretrizes da Cetesb. Ao fim da locação, emitimos o CTR (Controle de Transporte de Resíduos) e o MTR, documentos que comprovam que seu entulho foi destinado a Áreas de Transbordo e Triagem (ATT) autorizadas, onde materiais inertes são reciclados em brita e os rejeitos são aterrados ecologicamente.
                            </p>
                        </div>
                    </div>

                    <!-- Section 4 -->
                    <div>
                        <h2 class="text-2xl sm:text-[26px] font-black text-gray-900 mb-4 tracking-tight">
                            Regras de Ouro para o Uso Seguro da Caçamba
                        </h2>
                        <p class="text-gray-600 text-base leading-relaxed font-medium mb-4">
                            Para garantir uma operação sem atrasos e dentro da lei nas vias do Capelinha, pedimos atenção a três regras essenciais:
                        </p>
                        <ul class="space-y-3 text-gray-600 text-base leading-relaxed font-medium pl-2 mb-6">
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong>Limite de Volume (Sem "Morrinho"):</strong> O entulho não pode, de forma alguma, ultrapassar a altura máxima da borda da caçamba. O excesso gera risco iminente de queda de material na via durante a curva do caminhão, podendo causar graves acidentes.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong>Posicionamento Exigido por Lei:</strong> O equipamento é estacionado paralelamente à calçada. Não é permitido colocá-lo sobre tampas de bueiros (bocas de lobo), faixas de pedestres ou a menos de cinco metros das esquinas.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong>Materiais Proibidos:</strong> A caçamba destina-se a entulho de obra. É rigorosamente proibido o descarte de lixo orgânico doméstico, lixo hospitalar, pneus, tintas líquidas e telhas de amianto.</span>
                            </li>
                        </ul>
                        <p class="text-gray-600 text-base leading-relaxed font-medium">
                            Garantimos agilidade, frota revisada e orçamentos transparentes, sem taxas ocultas. Chame a nossa equipe agora mesmo pelo WhatsApp, escolha sua caçamba e mantenha a sua reforma limpa, segura e dentro da lei!
                        </p>
                    </div>

                </div>

                <!-- Right Column: Sticky Sidebar Card -->
                <aside class="w-full">
                    <div class="sticky top-28 bg-green-700 rounded-3xl p-6 sm:p-8 text-center shadow-2xl shadow-green-700/30 text-white">
                        <span class="inline-block text-xs font-black tracking-widest text-white/90 uppercase mb-4">
                            ORÇAMENTO GRATUITO
                        </span>
                        
                        <h3 class="text-2xl font-black text-white mb-6 leading-tight tracking-tight">
                            Interessado em alugar uma caçamba no Capelinha?
                        </h3>

                        <div class="space-y-3 mb-6">
                            <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 w-full py-4 px-6 bg-[#1c2331] text-white font-black text-sm sm:text-base rounded-xl hover:bg-black transition-all hover:scale-[1.02] active:scale-95 shadow-xl">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                                </svg>
                                Pedir no WhatsApp
                            </a>
                            <a href={phoneLink} class="flex items-center justify-center gap-2 w-full py-4 px-6 bg-white text-gray-950 font-black text-sm sm:text-base rounded-xl hover:bg-gray-50 transition-all hover:scale-[1.02] active:scale-95 shadow-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.539-4.239-7.136-7.136l1.292-.97c.363-.271.527-.734.418-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                                </svg>
                                Ligar Agora
                            </a>
                        </div>

                        <p class="text-xs font-bold text-white/80 mb-1">
                            Dúvidas? Fale com nossa equipe:
                        </p>
                        <a href={phoneLink} class="text-xl font-black text-white tracking-tight hover:underline block">
                            (11) 94375-8808
                        </a>
                    </div>
                </aside>

            </div>
        </section>

    </div>
</Layout>
