---
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../data/config';

const title = "Aluguel de Caçamba no Bananal - Preço Justo e Rápido";
const description = "Precisando de aluguel de caçamba no Bananal? Oferecemos frota própria, descarte 100% legalizado e emissão de MTR. Peça orçamento!";
const whatsappLink = `https://wa.me/5511943799889?text=${encodeURIComponent("Olá! Gostaria de um orçamento para aluguel de caçamba no bairro Bananal em Guarulhos.")}`;
const phoneLink = `tel:+5511943799889`;
---

<Layout title={title} description={description}>
    <div class="flex flex-col gap-0 w-full max-w-7xl mx-auto px-4 sm:px-6">

        <!-- 1. Hero da Página de Bairro -->
        <section class="max-w-5xl mx-auto w-full pt-16 pb-12 text-center px-4">
            <span class="inline-block py-1.5 px-4 rounded-full bg-green-700 text-white font-black text-xs mb-6 uppercase tracking-widest shadow-sm">
                Atendimento em Guarulhos
            </span>

            <h1 class="text-4xl md:text-[47px] font-black text-gray-900 mb-6 tracking-tighter leading-tight">
                Aluguel de Caçamba no <span class="text-green-700">Bananal</span>
            </h1>

            <p class="text-lg text-gray-600 leading-relaxed max-w-2xl mx-auto font-medium mb-10">
                Precisando de aluguel de caçamba no Bananal? Oferecemos frota própria, descarte 100% legalizado e emissão de MTR. Peça orçamento!
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center px-8 py-4 bg-green-700 text-white text-base font-black rounded-xl transition-all hover:scale-105 active:scale-95 shadow-xl hover:shadow-green-700/40 gap-2 w-full sm:w-auto">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                    </svg>
                    Orçamento via WhatsApp
                </a>
                <a href="#conteudo" class="inline-flex justify-center items-center px-8 py-4 bg-gray-100 text-gray-900 text-base font-black rounded-xl transition-all hover:bg-gray-200 hover:scale-105 active:scale-95 gap-2 w-full sm:w-auto shadow-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                    Ver Caçambas
                </a>
            </div>
        </section>

        <!-- 2. Three Feature Cards Row -->
        <section class="max-w-6xl mx-auto w-full my-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Card 1 -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-start">
                    <div class="w-10 h-10 rounded-xl bg-green-700 text-white flex items-center justify-center font-black mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Logística Expressa</h3>
                    <p class="text-sm text-gray-600 leading-relaxed font-medium">
                        Entrega e remoção ágeis e pontuais no bairro Bananal, garantindo que o entulho de sua reforma seja retirado sem atrasos.
                    </p>
                </div>

                <!-- Card 2 -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-start">
                    <div class="w-10 h-10 rounded-xl bg-green-700 text-white flex items-center justify-center font-black mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Descarte 100% Legal</h3>
                    <p class="text-sm text-gray-600 leading-relaxed font-medium">
                        Emissão de CTR e conformidade com as normas da SMMA Guarulhos, destinando resíduos a ATTs e aterros certificados.
                    </p>
                </div>

                <!-- Card 3 -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-start">
                    <div class="w-10 h-10 rounded-xl bg-green-700 text-white flex items-center justify-center font-black mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Posicionamento Seguro</h3>
                    <p class="text-sm text-gray-600 leading-relaxed font-medium">
                        Motoristas experientes para posicionamento correto da caçamba em vias públicas ou calçadas do Bananal.
                    </p>
                </div>
            </div>
        </section>

        <!-- 3. Main Two-Column Content (Left: Document / Right: Sticky Sidebar Card) -->
        <section id="conteudo" class="max-w-6xl mx-auto w-full my-8 pb-16">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-10 items-start">

                <!-- Left Column: Content Container -->
                <div class="lg:col-span-2 bg-white rounded-3xl p-8 sm:p-12 border border-gray-100 shadow-sm space-y-10">

                    <!-- Section 1 -->
                    <div>
                        <h2 class="text-2xl sm:text-[26px] font-black text-gray-900 mb-4 tracking-tight">
                            Aluguel de Caçamba no Bananal: Solução Segura e Rápida para Sua Obra
                        </h2>
                        <div class="space-y-4 text-gray-600 text-base leading-relaxed font-medium">
                            <p>
                                O bairro do Bananal, em Guarulhos, é conhecido por sua proximidade com o Aeroporto Internacional e por sua constante evolução, misturando áreas residenciais e comércios locais. Com o ritmo acelerado de manutenções e construções na região, o aluguel de caçamba no Bananal é um serviço essencial para manter a limpeza das ruas e a organização da sua obra. Trabalhamos com logística expressa, garantindo que o entulho da sua reforma seja removido rapidamente, com preço justo e total respeito ao seu cronograma.
                            </p>
                            <p>
                                Amontoar resíduos na calçada não apenas atrapalha o fluxo de pedestres, como também gera multas severas pela prefeitura. Ao locar uma caçamba estacionária conosco, você centraliza o lixo de forma segura, mantendo a estética da via e respeitando seus vizinhos.
                            </p>
                        </div>
                    </div>

                    <!-- Section 2 -->
                    <div>
                        <h2 class="text-2xl sm:text-[26px] font-black text-gray-900 mb-4 tracking-tight">
                            Qual o Tamanho Ideal de Caçamba para a sua Necessidade?
                        </h2>
                        <p class="text-gray-600 text-base leading-relaxed font-medium mb-4">
                            Entender o volume de entulho gerado é o primeiro passo para garantir eficiência e economia na sua obra. Confira abaixo os tamanhos disponíveis e suas indicações precisas:
                        </p>
                        <ul class="space-y-4 text-gray-600 text-base leading-relaxed font-medium pl-2">
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong><a href="/servicos/cacamba-4m3" class="text-green-700 hover:underline">Caçamba de 4m³</a>:</strong> Este é o equipamento mais solicitado para reformas residenciais padrão e obras de pequeno porte. Graças ao seu tamanho compacto, que ocupa o espaço equivalente ao de um carro popular, a caçamba de 4 metros cúbicos é perfeita para o descarte de materiais pesados, como restos de alvenaria, pisos, azulejos e terra, sem o risco de sobrecarregar o sistema hidráulico do caminhão.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong><a href="/servicos/cacamba-5m3" class="text-green-700 hover:underline">Caçamba de 5m³</a>:</strong> Uma excelente escolha intermediária para projetos que geram um volume um pouco maior de resíduos. A caçamba de 5 metros cúbicos acomoda perfeitamente a mistura de entulho denso (concreto e tijolos) com materiais levemente mais volumosos, como pedaços de gesso, restos de madeira e encanamentos retirados de reformas de banheiros ou cozinhas.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong><a href="/servicos/cacamba-6m3" class="text-green-700 hover:underline">Caçamba de 6m³</a>:</strong> Projetada estrategicamente para receber materiais de peso moderado e maior volume, a caçamba de 6 metros cúbicos é a solução ideal para descartar podas de árvores do quintal, placas de gesso cartonado (drywall), forros antigos e plásticos. Para garantir a segurança viária, ela não deve ser preenchida até o topo exclusivamente com materiais de alta densidade, como terra pura.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong><a href="/servicos/cacamba-7m3" class="text-green-700 hover:underline">Caçamba de 7m³</a>:</strong> Este modelo é voltado para atender demandas de comércios locais e pequenas indústrias no Bananal. A caçamba de 7 metros cúbicos possui excelente capacidade para armazenar resíduos volumosos e leves, como grandes embalagens, paletes de madeira descartados, sobras de isolamento térmico e papelão, reduzindo a necessidade de trocas constantes durante a limpeza.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong><a href="/servicos/cacamba-8m3" class="text-green-700 hover:underline">Caçamba de 8m³</a>:</strong> Sendo a maior entre as caçambas estacionárias convencionais, a versão de 8 metros cúbicos é destinada estritamente a materiais de grande volume e baixíssima densidade. Ela é amplamente locada para a limpeza de terrenos extensos (remoção de mato e galhadas volumosas) ou descarte de materiais industriais muito leves, como plásticos expansivos e espumas.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong><a href="/servicos/cacamba-roll-on" class="text-green-700 hover:underline">Caçamba Roll-on</a>:</strong> O sistema Roll-on (ou Roll-on Roll-off) é a estrutura definitiva para grandes demolições, limpeza de galpões e megaprojetos de engenharia. Movimentadas por caminhões trucados robustos, essas caçambas gigantes operam como contêineres e possuem capacidades que variam de 25m³ a 40m³. São indicadas exclusivamente para canteiros de obras que geram toneladas de resíduos diariamente e possuem espaço físico adequado para a manobra dos caminhões.</span>
                            </li>
                        </ul>
                    </div>

                    <!-- Section 3 -->
                    <div>
                        <h2 class="text-2xl sm:text-[26px] font-black text-gray-900 mb-4 tracking-tight">
                            Descarte 100% Legalizado e Compromisso Ambiental
                        </h2>
                        <div class="space-y-4 text-gray-600 text-base leading-relaxed font-medium">
                            <p>
                                A credibilidade de uma locadora de caçambas se mede pela sua responsabilidade ambiental. Existem muitos operadores clandestinos que descartam resíduos em áreas irregulares na periferia de Guarulhos, o que configura crime ambiental — e o contratante responde solidariamente pela infração.
                            </p>
                            <p>
                                Ao contratar nosso serviço, sua obra fica 100% regularizada. Cumprimos rigorosamente as normas da Secretaria Municipal de Meio Ambiente (SMMA) de Guarulhos. Todo o entulho recolhido no Bananal é destinado a Áreas de Transbordo e Triagem (ATT) certificadas, onde o que é reciclável vira matéria-prima (como brita ecológica) e o rejeito vai para aterros legalizados. Fornecemos o Controle de Transporte de Resíduos (CTR), garantindo a rastreabilidade total do seu entulho.
                            </p>
                        </div>
                    </div>

                    <!-- Section 4 -->
                    <div>
                        <h2 class="text-2xl sm:text-[26px] font-black text-gray-900 mb-4 tracking-tight">
                            Regras de Posicionamento e Segurança na Via
                        </h2>
                        <p class="text-gray-600 text-base leading-relaxed font-medium mb-4">
                            A segurança no trânsito do Bananal é nossa prioridade. Para um aluguel sem dores de cabeça:
                        </p>
                        <ul class="space-y-3 text-gray-600 text-base leading-relaxed font-medium pl-2 mb-6">
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span>A caçamba é posicionada paralelamente ao meio-fio, exatamente como um carro estacionado, respeitando guias rebaixadas, bueiros e pontos de ônibus.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span>Nossos equipamentos possuem faixas refletivas bem conservadas, garantindo excelente visibilidade noturna para evitar acidentes.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span>Lembramos que é proibido o descarte de lixo orgânico, telhas de amianto, tintas e produtos químicos na caçamba de construção civil.</span>
                            </li>
                        </ul>
                        <p class="text-gray-600 text-base leading-relaxed font-medium">
                            Não deixe o entulho travar o andamento da sua reforma. Solicite agora um orçamento rápido pelo WhatsApp e garanta a melhor logística de resíduos para a sua obra!
                        </p>
                    </div>

                </div>

                <!-- Right Column: Sticky Sidebar Card -->
                <aside class="w-full">
                    <div class="sticky top-28 bg-green-700 rounded-3xl p-6 sm:p-8 text-center shadow-2xl shadow-green-700/30 text-white">
                        <span class="inline-block text-xs font-black tracking-widest text-white/90 uppercase mb-4">
                            ORÇAMENTO GRATUITO
                        </span>
                        
                        <h3 class="text-2xl font-black text-white mb-6 leading-tight tracking-tight">
                            Interessado em alugar uma caçamba no Bananal?
                        </h3>

                        <div class="space-y-3 mb-6">
                            <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 w-full py-4 px-6 bg-[#1c2331] text-white font-black text-sm sm:text-base rounded-xl hover:bg-black transition-all hover:scale-[1.02] active:scale-95 shadow-xl">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                                </svg>
                                Pedir no WhatsApp
                            </a>
                            <a href={phoneLink} class="flex items-center justify-center gap-2 w-full py-4 px-6 bg-white text-gray-950 font-black text-sm sm:text-base rounded-xl hover:bg-gray-50 transition-all hover:scale-[1.02] active:scale-95 shadow-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.539-4.239-7.136-7.136l1.292-.97c.363-.271.527-.734.418-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                                </svg>
                                Ligar Agora
                            </a>
                        </div>

                        <p class="text-xs font-bold text-white/80 mb-1">
                            Dúvidas? Fale com nossa equipe:
                        </p>
                        <a href={phoneLink} class="text-xl font-black text-white tracking-tight hover:underline block">
                            (11) 94375-6600
                        </a>
                    </div>
                </aside>

            </div>
        </section>

    </div>
</Layout>
