---
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../data/config';

const title = "Aluguel de Caçamba no Cabuçu: Obras e Terraplenagem";
const description = "Buscando aluguel de caçamba no Cabuçu? Frota para terraplenagem, descarte 100% legal e emissão de laudo CTR. Peça seu orçamento!";
const whatsappLink = `https://wa.me/5511943799889?text=${encodeURIComponent("Olá! Gostaria de um orçamento para aluguel de caçamba no Cabuçu em Guarulhos.")}`;
const phoneLink = `tel:+5511943799889`;
---

<Layout title={title} description={description}>
    <div class="flex flex-col gap-0 w-full max-w-7xl mx-auto px-4 sm:px-6">

        <!-- 1. Hero da Página de Bairro -->
        <section class="max-w-5xl mx-auto w-full pt-16 pb-12 text-center px-4">
            <span class="inline-block py-1.5 px-4 rounded-full bg-green-700 text-white font-black text-xs mb-6 uppercase tracking-widest shadow-sm">
                Atendimento em Guarulhos
            </span>

            <h1 class="text-4xl md:text-[47px] font-black text-gray-900 mb-6 tracking-tighter leading-tight">
                Aluguel de Caçamba no <span class="text-green-700">Cabuçu</span>
            </h1>

            <p class="text-lg text-gray-600 leading-relaxed max-w-2xl mx-auto font-medium mb-10">
                Buscando aluguel de caçamba no Cabuçu? Frota para terraplenagem, descarte 100% legal e emissão de laudo CTR. Peça seu orçamento!
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center px-8 py-4 bg-green-700 text-white text-base font-black rounded-xl transition-all hover:scale-105 active:scale-95 shadow-xl hover:shadow-green-700/40 gap-2 w-full sm:w-auto">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                    </svg>
                    Orçamento via WhatsApp
                </a>
                <a href="#conteudo" class="inline-flex justify-center items-center px-8 py-4 bg-gray-100 text-gray-900 text-base font-black rounded-xl transition-all hover:bg-gray-200 hover:scale-105 active:scale-95 gap-2 w-full sm:w-auto shadow-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                    Ver Caçambas
                </a>
            </div>
        </section>

        <!-- 2. Three Feature Cards Row -->
        <section class="max-w-6xl mx-auto w-full my-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Card 1 -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-start">
                    <div class="w-10 h-10 rounded-xl bg-green-700 text-white flex items-center justify-center font-black mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375a1.125 1.125 0 01-1.125-1.125V14.25m17.25 4.5a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h1.125c.621 0 1.129-.504 1.09-1.124a17.902 17.902 0 00-3.213-9.193 2.056 2.056 0 00-1.58-.86H14.25M16.5 18.75h-2.25m0-11.25V3.75m0 3.75h3.75" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Frota para Terraplenagem</h3>
                    <p class="text-sm text-gray-600 leading-relaxed font-medium">
                        Caminhões poli-guindaste robustos para movimentação de terra em ladeiras e vias de terra batida.
                    </p>
                </div>

                <!-- Card 2 -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-start">
                    <div class="w-10 h-10 rounded-xl bg-green-700 text-white flex items-center justify-center font-black mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Descarte 100% Legalizado</h3>
                    <p class="text-sm text-gray-600 leading-relaxed font-medium">
                        Licença SMMA e Cetesb com emissão de laudo CTR e MTR, protegendo sua obra e a Serra da Cantareira.
                    </p>
                </div>

                <!-- Card 3 -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-start">
                    <div class="w-10 h-10 rounded-xl bg-green-700 text-white flex items-center justify-center font-black mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Pontualidade e Segurança</h3>
                    <p class="text-sm text-gray-600 leading-relaxed font-medium">
                        Posicionamento estratégico da caçamba facilitando o trabalho de pás carregadeiras e equipes de obra.
                    </p>
                </div>
            </div>
        </section>

        <!-- 3. Layout de Conteúdo: Duas Colunas (Texto + Sidebar Sticky) -->
        <section id="conteudo" class="max-w-6xl mx-auto w-full py-8 mb-16">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 sm:gap-12 items-start">
                
                <!-- Left Column: White Document Container with 4 Sections -->
                <div class="lg:col-span-2 bg-white rounded-3xl p-6 sm:p-10 border border-gray-100 shadow-sm space-y-12">
                    
                    <!-- Section 1: Intro -->
                    <div>
                        <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight mb-6">
                            Aluguel de Caçamba no Cabuçu: Logística Segura e Proteção Ambiental
                        </h2>
                        <p class="text-gray-600 text-base leading-relaxed font-medium mb-4">
                            A região do bairro Cabuçu apresenta características singulares na geografia de Guarulhos. Sendo uma expressiva área de expansão urbana, o bairro faz divisa direta com importantes cinturões verdes e áreas de preservação ambiental, como o entorno da Serra da Cantareira. Com o crescente número de chácaras, loteamentos recentes e asfaltamento de vias, o volume de terraplenagem e resíduos gerados disparou. Por estar imerso nessa rica área natural, o aluguel de caçamba no Cabuçu exige a contratação de uma empresa com frota robusta para movimentação de terra e extremo rigor no cumprimento das leis ambientais.
                        </p>
                        <p class="text-gray-600 text-base leading-relaxed font-medium">
                            O perfil predominante das construções no bairro envolve serviços de corte e aterro, fundações e muros de arrimo, gerando quantidades massivas de terra úmida, raízes e pedras. Compreendemos perfeitamente as particularidades viárias do Cabuçu, onde muitas ruas possuem aclives acentuados ou trechos de terra batida. Nossos motoristas de caminhão poli-guindaste são altamente treinados para navegar nessas condições adversas, posicionando a caçamba no local mais seguro e produtivo para as pás carregadeiras e para a sua equipe de pedreiros.
                        </p>
                    </div>

                    <hr class="border-gray-100" />

                    <!-- Section 2: Dumpster Sizes (6 cards) -->
                    <div>
                        <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight mb-3">
                            Qual o Tamanho de Caçamba Ideal para o seu Loteamento?
                        </h2>
                        <p class="text-gray-600 text-base leading-relaxed font-medium mb-8">
                            Em áreas de desbravamento e intensa movimentação de solo, o cálculo entre volume e peso da carga é o fator mais crítico para evitar acidentes. Conheça as nossas opções disponíveis para a região do Cabuçu:
                        </p>

                        <div class="space-y-6">
                            <!-- 4m³ -->
                            <div class="p-5 rounded-2xl border border-gray-100 bg-gray-50/50">
                                <h3 class="text-xl font-black text-gray-900 mb-2"><a href="/servicos/cacamba-4m3" class="hover:text-green-700 hover:underline transition-colors">Caçamba de 4m³</a></h3>
                                <p class="text-gray-600 text-sm leading-relaxed font-medium">
                                    O equipamento mais seguro, resistente e exigido para obras de fundação e terraplenagem. Com dimensões compactas, a caçamba de 4 metros cúbicos suporta materiais de altíssima densidade, como terra de escavação (barro úmido), pedras brutas e blocos maciços. Ela aguenta o peso bruto sem comprometer o sistema hidráulico do caminhão durante o içamento nas ladeiras ou estradas de terra do bairro.
                                </p>
                            </div>

                            <!-- 5m³ -->
                            <div class="p-5 rounded-2xl border border-gray-100 bg-gray-50/50">
                                <h3 class="text-xl font-black text-gray-900 mb-2"><a href="/servicos/cacamba-5m3" class="hover:text-green-700 hover:underline transition-colors">Caçamba de 5m³</a></h3>
                                <p class="text-gray-600 text-sm leading-relaxed font-medium">
                                    Uma excelente opção intermediária para chácaras e terrenos que já superaram o corte de terra e iniciaram a fase estrutural (alvenaria). A caçamba de 5 metros cúbicos acomoda de forma eficiente a mistura de entulho denso com resíduos levemente mais volumosos, como pedaços de madeira de cercas, raízes médias, argamassa e restos de tijolos.
                                </p>
                            </div>

                            <!-- 6m³ -->
                            <div class="p-5 rounded-2xl border border-gray-100 bg-gray-50/50">
                                <h3 class="text-xl font-black text-gray-900 mb-2"><a href="/servicos/cacamba-6m3" class="hover:text-green-700 hover:underline transition-colors">Caçamba de 6m³</a></h3>
                                <p class="text-gray-600 text-sm leading-relaxed font-medium">
                                    Projetada especificamente para materiais de peso moderado e alto volume. A caçamba de 6 metros cúbicos é amplamente locada no Cabuçu para o descarte de galhadas secas, madeiramento de telhados, plásticos agrícolas e gesso. Atenção: Em escavações, ela jamais deve ser preenchida até o limite com terra pura, sob risco de exceder a tara de segurança do caminhão em vias não pavimentadas.
                                </p>
                            </div>

                            <!-- 7m³ -->
                            <div class="p-5 rounded-2xl border border-gray-100 bg-gray-50/50">
                                <h3 class="text-xl font-black text-gray-900 mb-2"><a href="/servicos/cacamba-7m3" class="hover:text-green-700 hover:underline transition-colors">Caçamba de 7m³</a></h3>
                                <p class="text-gray-600 text-sm leading-relaxed font-medium">
                                    Este modelo atende de forma estratégica à demanda de construção de grandes galpões ou sedes campestres na região. A caçamba de 7 metros cúbicos possui excelente capacidade para resíduos leves da fase de acabamento, como grandes embalagens, paletes de madeira descartados, tubulações de PVC e rolos de papelão, otimizando o fluxo de viagens.
                                </p>
                            </div>

                            <!-- 8m³ -->
                            <div class="p-5 rounded-2xl border border-gray-100 bg-gray-50/50">
                                <h3 class="text-xl font-black text-gray-900 mb-2"><a href="/servicos/cacamba-8m3" class="hover:text-green-700 hover:underline transition-colors">Caçamba de 8m³</a></h3>
                                <p class="text-gray-600 text-sm leading-relaxed font-medium">
                                    A maior entre as caçambas estacionárias convencionais. A versão de 8 metros cúbicos é destinada estritamente a resíduos de volume expansivo e baixíssima densidade. Ela é ideal para a limpeza rápida da superfície verde dos lotes (recolhimento de mato seco e folhagens soltas) ou para materiais construtivos levíssimos, como espumas e isopor.
                                </p>
                            </div>

                            <!-- Roll-on -->
                            <div class="p-5 rounded-2xl border border-gray-100 bg-gray-50/50">
                                <h3 class="text-xl font-black text-gray-900 mb-2"><a href="/servicos/cacamba-roll-on" class="hover:text-green-700 hover:underline transition-colors">Caçamba Roll-on</a></h3>
                                <p class="text-gray-600 text-sm leading-relaxed font-medium">
                                    O sistema Roll-on (ou Roll-on Roll-off) opera com contêineres colossais de 25m³ a 40m³, movimentados por caminhões trucados superpesados. São indicados para desmatamento autorizado de grandes áreas e terraplenagem industrial. Contudo, devido ao seu peso extremo e à necessidade de amplo espaço para manobras, não são adequados para ruas estreitas, íngremes ou vias de terra batida instáveis no interior do Cabuçu, exigindo sempre solo firme e nivelado para operar.
                                </p>
                            </div>
                        </div>
                    </div>

                    <hr class="border-gray-100" />

                    <!-- Section 3: Legal Compliance -->
                    <div>
                        <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight mb-6">
                            Blindagem Jurídica e Defesa da Serra da Cantareira
                        </h2>
                        <p class="text-gray-600 text-base leading-relaxed font-medium mb-4">
                            Por ser uma região de transição rural-urbana cercada por matas, o Cabuçu infelizmente atrai a ação predatória de "caçambeiros clandestinos" que cobram barato para despejar lixo em córregos e encostas. A legislação ambiental é implacável: o proprietário do imóvel é corresponsável pelo resíduo e sofrerá pesadas multas e embargos caso o entulho da sua chácara seja rastreado em uma área de preservação.
                        </p>
                        <p class="text-gray-600 text-base leading-relaxed font-medium">
                            Ao alugar nossa frota, sua obra ganha blindagem jurídica absoluta. Somos uma empresa rigorosamente licenciada pela Secretaria Municipal de Meio Ambiente (SMMA) e pela Cetesb. Toda a terra, pedras e restos de alvenaria retirados do seu lote são direcionados para Áreas de Transbordo e Triagem (ATT) e aterros homologados. Emitimos e entregamos automaticamente o MTR e o CTR (Controle de Transporte de Resíduos), laudos oficiais que comprovam que a sua construção respeita e protege a natureza local.
                        </p>
                    </div>

                    <hr class="border-gray-100" />

                    <!-- Section 4: Safety Rules -->
                    <div>
                        <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight mb-4">
                            Regras Vitais Para Movimentação de Terra e Entulho
                        </h2>
                        <p class="text-gray-600 text-base leading-relaxed font-medium mb-6">
                            Para garantirmos um escoamento ágil e seguro nas vias muitas vezes acidentadas do bairro, o carregamento exige três cuidados fundamentais:
                        </p>
                        <ul class="space-y-3 text-gray-600 text-base leading-relaxed font-medium pl-2 mb-6">
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong>Distribuição de Carga:</strong> Ao utilizar pás carregadeiras, distribua o peso da terra e das rochas de maneira uniforme por toda a caixa metálica. O acúmulo de peso em um único lado desequilibra o equipamento, gerando risco de tombamento durante o içamento.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong>Limite Seguro (Sem "Morrinho"):</strong> A terra não pode ultrapassar as bordas superiores da caçamba. Em ruas com declives ou estradas de terra batida, os solavancos fazem o excesso escorregar, causando acidentes perigosos e espalhando sujeira.</span>
                            </li>
                            <li class="flex items-start gap-2">
                                <span class="text-green-700 font-bold">•</span>
                                <span><strong>Zero Contaminação:</strong> A destinação de aterros de inertes exige que a caçamba contenha apenas restos de obra ou resíduos vegetais limpos. É terminantemente proibido o descarte de lixo orgânico doméstico, latas de produtos químicos, tintas ou óleos.</span>
                            </li>
                        </ul>
                        <p class="text-gray-600 text-base leading-relaxed font-medium">
                            Construa sua casa ou chácara no Cabuçu com logística inteligente, rapidez e documentação ambiental em dia. Fale agora mesmo com nossa equipe via WhatsApp, solicite um orçamento transparente e agende a locação das suas caçambas!
                        </p>
                    </div>

                </div>

                <!-- Right Column: Sticky Sidebar Card -->
                <aside class="w-full">
                    <div class="sticky top-28 bg-green-700 rounded-3xl p-6 sm:p-8 text-center shadow-2xl shadow-green-700/30 text-white">
                        <span class="inline-block text-xs font-black tracking-widest text-white/90 uppercase mb-4">
                            ORÇAMENTO GRATUITO
                        </span>
                        
                        <h3 class="text-2xl font-black text-white mb-6 leading-tight tracking-tight">
                            Interessado em alugar uma caçamba no Cabuçu?
                        </h3>

                        <div class="space-y-3 mb-6">
                            <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 w-full py-4 px-6 bg-[#1c2331] text-white font-black text-sm sm:text-base rounded-xl hover:bg-black transition-all hover:scale-[1.02] active:scale-95 shadow-xl">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                                </svg>
                                Pedir no WhatsApp
                            </a>
                            <a href={phoneLink} class="flex items-center justify-center gap-2 w-full py-4 px-6 bg-white text-gray-950 font-black text-sm sm:text-base rounded-xl hover:bg-gray-50 transition-all hover:scale-[1.02] active:scale-95 shadow-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.539-4.239-7.136-7.136l1.292-.97c.363-.271.527-.734.418-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                                </svg>
                                Ligar Agora
                            </a>
                        </div>

                        <p class="text-xs font-bold text-white/80 mb-1">
                            Dúvidas? Fale com nossa equipe:
                        </p>
                        <a href={phoneLink} class="text-xl font-black text-white tracking-tight hover:underline block">
                            (11) 94379-9889
                        </a>
                    </div>
                </aside>

            </div>
        </section>

    </div>
</Layout>
