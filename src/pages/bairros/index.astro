    .filter((b) => b.link && b.link !== '#')
    .sort((a, b) => a.nome.localeCompare(b.nome, 'pt-BR'));
---

<Layout title="Bairros de Atuação - Locação de Caçambas" description="Confira as regiões onde atuamos com locação de caçambas em Guarulhos e região.">
    <div class="flex flex-col gap-0">
    <!-- Header Section -->
    <section class="max-w-4xl mx-auto w-full text-center px-6">
        <h1 class="text-4xl md:text-[47px] font-black text-gray-900 mb-6 tracking-tighter leading-tight">
            Bairros de <span class="text-green-700">Atuação</span>
        </h1>
        <p class="text-lg text-gray-600 font-medium mb-16">
            Consulte nossa área de cobertura e conte com agilidade e compromisso na remoção de entulhos para a sua obra.
        </p>
    </section>

    <!-- Main Content: Sidebar + Grid -->
    <section class="max-w-7xl mx-auto w-full px-4 pb-16 flex flex-col lg:flex-row gap-8 lg:gap-12">
        
        <!-- Sidebar Navigation -->
        <aside class="w-full lg:w-1/4 shrink-0">
            <div class="sticky top-28 bg-white rounded-2xl border border-gray-100 p-4 shadow-sm flex flex-col max-h-[calc(100vh-140px)]">
                <!-- Link Principal para Todos os Bairros -->
                <div class="mb-3 pb-3 border-b border-gray-100 shrink-0">
                    <a href="/bairros" class="flex items-center justify-between px-4 py-3 text-sm md:text-base rounded-r-lg border-l-4 border-green-700 bg-gray-50 font-black text-gray-900 transition-colors">
                        <span>Guarulhos (Todos)</span>
                    </a>
                </div>

                <!-- Bairros com Conteúdo Disponível -->
                <div class="px-2 pb-2 shrink-0">
                    <span class="text-xs font-black uppercase tracking-wider text-gray-400 block px-2">
                        Bairros Atendidos
                    </span>
                </div>

                <!-- Lista com rolagem interna que não transborda do menu -->
                <div class="overflow-y-auto min-h-0 flex-1 pr-1 space-y-1 sidebar-scroll">
                    <ul class="space-y-1">
                        {bairrosAtivos.map((bairro) => (
                            <li>
                                <a 
                                    href={bairro.link} 
                                    class="flex items-center justify-between px-3 py-2 text-sm font-semibold text-gray-600 hover:text-green-700 hover:bg-green-50/60 rounded-lg transition-all group"
                                >
                                    <span class="group-hover:translate-x-0.5 transition-transform">{bairro.nome}</span>
                                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-3.5 h-3.5 text-gray-300 group-hover:text-green-700 group-hover:translate-x-0.5 transition-all shrink-0">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5" />
                                    </svg>
                                </a>
                            </li>
                        ))}
                    </ul>
                </div>
            </div>
        </aside>

        <!-- Cards Grid -->
        <div class="w-full lg:w-3/4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {bairrosAtivos.map((bairro) => (
                    <a href={bairro.link} class="block bg-white p-6 rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl hover:border-green-700 transition-all hover:-translate-y-1 group flex flex-col justify-between min-h-[140px]">
                        <div>
                            <span class="text-xs font-bold text-gray-400 uppercase tracking-wider block mb-1">
                                {bairro.cidade}
                            </span>
                            <h3 class="text-xl font-black text-gray-900 group-hover:text-green-700 transition-colors mb-2">
                                {bairro.nome}
                            </h3>
                            {bairro.descricao && (
                                <p class="text-sm text-gray-600 line-clamp-3 leading-relaxed font-medium mb-4">
                                    {bairro.descricao}
                                </p>
                            )}
                        </div>
                        <span class="text-green-700 font-bold text-sm flex items-center gap-2 group-hover:gap-3 transition-all mt-4 pt-2 border-t border-gray-50">
                            Ver detalhes do bairro
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                            </svg>
                        </span>
                    </a>
                ))}
            </div>
        </div>

    </section>

    <!-- Bottom CTA -->
    <section class="text-center max-w-4xl mx-auto mt-10 mb-24 px-6">
        <h2 class="text-3xl md:text-4xl font-black text-gray-900 mb-6 tracking-tighter leading-tight">Sua região não <span class="text-green-700">está listada?</span></h2>
        <p class="text-lg text-gray-600 mb-10 font-medium">Entre em contato com a nossa equipe no WhatsApp para verificarmos a disponibilidade e o valor do frete.</p>
        <div class="flex flex-col sm:flex-row gap-6 justify-center">
            <a href={`https://wa.me/${SITE_CONFIG.contact.whatsapp}`} target="_blank" class="inline-flex justify-center items-center px-10 py-5 bg-green-700 text-white text-base font-black rounded-xl transition-all hover:scale-105 active:scale-95 shadow-xl hover:shadow-green-700/40 gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                </svg>
                Chamar no WhatsApp
            </a>
            <a href={`tel:${SITE_CONFIG.contact.phone.replace(/[^0-9+]/g, '')}`} class="inline-flex justify-center items-center px-10 py-5 bg-gray-100 text-gray-900 text-base font-black rounded-xl transition-all hover:bg-gray-200 hover:scale-105 active:scale-95 shadow-xl gap-2">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.539-4.239-7.136-7.136l1.292-.97c.363-.271.527-.734.418-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
                Ligar Agora
            </a>
        </div>
    </section>
    </div>

    <style>
        .sidebar-scroll {
            scrollbar-width: thin;
            scrollbar-color: #cbd5e1 transparent;
        }
        .sidebar-scroll::-webkit-scrollbar {
            width: 6px;
        }
        .sidebar-scroll::-webkit-scrollbar-track {
            background: transparent;
        }
        .sidebar-scroll::-webkit-scrollbar-thumb {
            background-color: #cbd5e1;
            border-radius: 9999px;
        }
        .sidebar-scroll::-webkit-scrollbar-thumb:hover {
            background-color: #15803d;
        }
    </style>
</Layout>
