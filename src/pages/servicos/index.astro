---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../data/config';

const servicos = await getCollection('servicos');
const ordemSolucoes = [
    'cacamba-para-reformas-residenciais',
    'cacamba-para-condominios',
    'cacamba-para-construtoras',
    'cacamba-para-empresas',
    'cacamba-para-demolicoes',
    'troca-programada-de-cacambas',
];
const ordemCapacidades = [
    'cacamba-3m3', 'cacamba-4m3', 'cacamba-5m3', 'cacamba-6m3',
    'cacamba-7m3', 'cacamba-8m3', 'cacamba-9m3', 'cacamba-roll-on',
];
const ordenar = (ordem: string[]) => ordem
    .map(id => servicos.find(servico => servico.id === id))
    .filter((servico): servico is NonNullable<typeof servico> => Boolean(servico));
const solucoes = ordenar(ordemSolucoes);
const capacidades = ordenar(ordemCapacidades);
---
<Layout title="Tamanhos e Serviços de Caçambas | Aluga Caçamba Garantido" description="Caçambas para reformas, condomínios, construtoras, empresas e demolições, com diferentes capacidades e atendimento planejado em Guarulhos.">
    <section class="max-w-6xl mx-auto w-full">
        <div class="text-center max-w-4xl mx-auto mb-16">
            <h1 class="text-4xl md:text-[47px] font-black text-gray-900 mb-5 tracking-tighter leading-tight">Soluções e Serviços de <span class="text-green-700">Caçambas em Guarulhos</span></h1>
            <p class="text-base md:text-lg text-gray-600 leading-relaxed">Escolha o atendimento conforme o tipo de obra ou consulte as capacidades disponíveis para definir a caçamba adequada.</p>
        </div>

        <section aria-labelledby="servicos-por-obra">
            <div class="text-center mb-10">
                <h2 id="servicos-por-obra" class="text-3xl md:text-[42px] font-black text-gray-900 mb-4 tracking-tighter">Serviços por <span class="text-green-700">tipo de obra</span></h2>
                <p class="text-gray-600 max-w-3xl mx-auto">Atendimento especializado para diferentes rotinas, acessos, volumes e formas de geração de resíduos.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
                {solucoes.map((servico, index) => (
                    <a href={`/servicos/${servico.id}`} class="flex flex-col bg-white p-7 md:p-8 rounded-3xl border-2 border-gray-100 hover:border-green-600 transition-all hover:-translate-y-2 hover:shadow-2xl hover:shadow-green-900/10 group">
                        <div class="w-14 h-14 rounded-2xl bg-green-50 text-green-700 flex items-center justify-center mb-6 group-hover:bg-green-700 group-hover:text-white transition-colors">
                            <span class="text-lg font-black">{String(index + 1).padStart(2, '0')}</span>
                        </div>
                        <h3 class="text-xl md:text-2xl font-black text-gray-900 mb-4 group-hover:text-green-700 transition-colors tracking-tighter">{servico.data.title}</h3>
                        <p class="text-gray-600 text-base leading-relaxed mb-6 flex-grow">{servico.data.description}</p>
                        <span class="text-green-700 font-black flex items-center gap-2">
                            Ver solução
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 group-hover:translate-x-1 transition-transform"><path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" /></svg>
                        </span>
                    </a>
                ))}
            </div>
        </section>

        <section aria-labelledby="capacidades-disponiveis" class="mt-24 pt-20 border-t border-gray-100">
            <div class="text-center mb-10">
                <h2 id="capacidades-disponiveis" class="text-3xl md:text-[42px] font-black text-gray-900 mb-4 tracking-tighter">Caçambas por <span class="text-green-700">capacidade</span></h2>
                <p class="text-gray-600 max-w-3xl mx-auto">Consulte os tamanhos disponíveis e veja qual capacidade pode atender melhor ao volume e ao tipo de material da obra.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-7">
                {capacidades.map(servico => (
                    <a href={`/servicos/${servico.id}`} class="flex flex-col bg-white p-6 rounded-3xl border-2 border-gray-100 hover:border-green-600 transition-all hover:-translate-y-2 hover:shadow-xl group">
                        <div class="aspect-[4/3] mb-5 flex items-center justify-center overflow-hidden rounded-2xl bg-white">
                            <img src={servico.data.image || "/cacamba-verde.webp"} alt={servico.data.title} width="400" height="300" loading="lazy" decoding="async" class="w-full h-full object-cover object-bottom mix-blend-multiply group-hover:scale-105 transition-transform duration-500" />
                        </div>
                        <h3 class="text-xl font-black text-gray-900 mb-3 group-hover:text-green-700 transition-colors tracking-tighter">{servico.data.title}</h3>
                        <p class="text-gray-600 text-sm leading-relaxed mb-5 flex-grow">{servico.data.description}</p>
                        <span class="text-green-700 font-black flex items-center gap-2">
                            Ver capacidade
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 group-hover:translate-x-1 transition-transform">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                        </svg>
                        </span>
                    </a>
                ))}
            </div>
        </section>

        <!-- CTA Action Section -->
        <section class="text-center max-w-4xl mx-auto mt-24 mb-8">
            <h2 class="text-3xl md:text-[47px] font-black text-gray-900 mb-6 tracking-tighter leading-tight">Precisa de ajuda para <span class="text-green-700">escolher?</span></h2>
            <p class="text-base text-gray-600 mb-10 font-medium">Fale com nossos especialistas agora e reserve a caçamba ideal para a sua obra.</p>
            <div class="flex flex-col sm:flex-row gap-6 justify-center">
                <a href={`https://wa.me/${SITE_CONFIG.contact.whatsapp}`} target="_blank" class="inline-flex justify-center items-center px-10 py-5 bg-green-700 text-white text-base font-black rounded-xl transition-all hover:scale-105 active:scale-95 shadow-xl hover:shadow-green-700/40 gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                    </svg>
                    Chamar no WhatsApp
                </a>
                <a href={`tel:${SITE_CONFIG.contact.phone.replace(/[^0-9+]/g, '')}`} class="inline-flex justify-center items-center px-10 py-5 bg-gray-100 text-gray-900 text-base font-black rounded-xl transition-all hover:bg-gray-200 hover:scale-105 active:scale-95 shadow-xl gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.539-4.239-7.136-7.136l1.292-.97c.363-.271.527-.734.418-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                    </svg>
                    Ligar Agora
                </a>
            </div>
        </section>
    </section>
</Layout>
