---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export const prerender = true;

export async function getStaticPaths() {
  const servicos = await getCollection('servicos');
  return servicos.map(servico => ({
    params: { slug: servico.id },
    props: { servico },
  }));
}

const { servico } = Astro.props;
if (!servico) return Astro.redirect('/404');
const { Content } = await render(servico);

let specAltura = "1,20m";
let specLargura = "1,40m";
let specComprimento = "2,50m";
let specCapacidade = "4m³";
let specCarga = "4,5 Toneladas";
let specAdicional = "Equivalente a 220 Latas";

if (servico.id === "cacamba-5m3") {
  specAltura = "1,40m";
  specLargura = "1,60m";
  specComprimento = "2,80m";
  specCapacidade = "5m³";
  specCarga = "6,0 Toneladas";
  specAdicional = "Equivalente a 270 Latas";
} else if (servico.id === "cacamba-6m3") {
  specAltura = "1,50m";
  specLargura = "1,70m";
  specComprimento = "3,00m";
  specCapacidade = "6m³";
  specCarga = "7,5 Toneladas";
  specAdicional = "Equivalente a 320 Latas";
} else if (servico.id === "cacamba-7m3") {
  specAltura = "1,60m";
  specLargura = "1,80m";
  specComprimento = "3,20m";
  specCapacidade = "7m³";
  specCarga = "8,0 Toneladas";
  specAdicional = "Equivalente a 380 Latas";
} else if (servico.id === "cacamba-8m3") {
  specAltura = "1,70m";
  specLargura = "1,90m";
  specComprimento = "3,40m";
  specCapacidade = "8m³";
  specCarga = "9,0 Toneladas";
  specAdicional = "Equivalente a 420 Latas";
} else if (servico.id === "cacamba-roll-on") {
  specAltura = "1,80m";
  specLargura = "2,40m";
  specComprimento = "6,00m";
  specCapacidade = "15m³ a 30m³";
  specCarga = "12,0 Toneladas";
  specAdicional = "Para Demolição Total";
}
---
<Layout title={`${servico.data.title} | DiskCaçamba`} description={servico.data.description}>
    <!-- Hero do Serviço -->
    <section class="max-w-5xl mx-auto w-full pt-16 pb-12 text-center px-4">
        <span class="inline-block py-1.5 px-4 rounded-full bg-green-700 text-white font-black text-xs mb-6 uppercase tracking-widest shadow-sm">
            Serviços Especializados
        </span>
        <h1 class="text-4xl md:text-[47px] font-black text-gray-900 mb-16 tracking-tighter leading-tight">{servico.data.title}</h1>
        <p class="text-lg text-gray-600 leading-relaxed max-w-2xl mx-auto font-medium mb-10">
            {servico.data.description}
        </p>
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
            <a href="https://wa.me/5511943758808" target="_blank" class="inline-flex justify-center items-center px-8 py-4 bg-green-700 text-white text-base font-black rounded-xl transition-all hover:scale-105 active:scale-95 shadow-xl hover:shadow-green-700/40 gap-2 w-full sm:w-auto">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                    <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                </svg>
                Chamar no WhatsApp
            </a>
            <a href="tel:+5511943758808" class="inline-flex justify-center items-center px-8 py-4 bg-gray-100 text-gray-900 text-base font-black rounded-xl transition-all hover:bg-gray-200 hover:scale-105 active:scale-95 gap-2 w-full sm:w-auto shadow-xl">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.539-4.239-7.136-7.136l1.292-.97c.363-.271.527-.734.418-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                </svg>
                Ligar Agora
            </a>
        </div>
    </section>

    <!-- Main Content Area -->
    <section class="max-w-7xl mx-auto w-full px-4 mb-24 flex flex-col lg:flex-row gap-12 lg:gap-16">
        
        <!-- Coluna da Esquerda (Conteúdo) -->
        <div class="w-full lg:w-2/3 flex flex-col gap-12">
            
            <!-- Grid de Especificações -->
            <div id="especificacoes" class="scroll-mt-24">
                <h2 class="text-2xl md:text-[47px] font-black text-gray-900 mb-6 tracking-tighter">Especificações Técnicas</h2>
                <div class="grid grid-cols-2 md:grid-cols-3 gap-6 bg-white border border-gray-100 p-8 rounded-3xl shadow-sm">
                    <div>
                        <div class="text-sm text-gray-500 font-medium mb-1">Altura</div>
                        <div class="text-xl font-black text-gray-900">{specAltura}</div>
                    </div>
                    <div>
                        <div class="text-sm text-gray-500 font-medium mb-1">Largura</div>
                        <div class="text-xl font-black text-gray-900">{specLargura}</div>
                    </div>
                    <div>
                        <div class="text-sm text-gray-500 font-medium mb-1">Comprimento</div>
                        <div class="text-xl font-black text-gray-900">{specComprimento}</div>
                    </div>
                    <div>
                        <div class="text-sm text-gray-500 font-medium mb-1">Capacidade</div>
                        <div class="text-xl font-black text-gray-900">{specCapacidade}</div>
                    </div>
                    <div>
                        <div class="text-sm text-gray-500 font-medium mb-1">Carga Máxima</div>
                        <div class="text-xl font-black text-gray-900">{specCarga}</div>
                    </div>
                    <div>
                        <div class="text-sm text-gray-500 font-medium mb-1">Adicional</div>
                        <div class="text-xl font-black text-gray-900">{specAdicional}</div>
                    </div>
                </div>
            </div>

            <!-- Imagem e Markdown -->
            <div>
                {servico.data.image && (
                    <img src={servico.data.image} alt={servico.data.title} class="w-full max-w-lg mx-auto object-contain mb-10 drop-shadow-xl" />
                )}
                <article class="prose prose-lg prose-slate max-w-none prose-headings:font-black prose-headings:tracking-tighter prose-headings:text-gray-900 prose-a:text-primary hover:prose-a:text-primary/80 prose-li:marker:text-primary">
                    <Content />
                </article>
            </div>

            <!-- Benefícios e Aplicações -->
            <div class="bg-gray-50 border border-gray-100 rounded-3xl p-8 md:p-10">
                <h3 class="text-2xl font-black text-gray-900 mb-8 tracking-tighter">Benefícios e Aplicações</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <div class="flex gap-4">
                        <div class="w-6 h-6 rounded bg-yellow-100 text-yellow-600 flex items-center justify-center shrink-0">✓</div>
                        <div>
                            <h4 class="font-bold text-gray-900 mb-1">Praticidade</h4>
                            <p class="text-sm text-gray-600 leading-relaxed">Tamanho perfeito para adequar em garagens e ruas estreitas.</p>
                        </div>
                    </div>
                    <div class="flex gap-4">
                        <div class="w-6 h-6 rounded bg-yellow-100 text-yellow-600 flex items-center justify-center shrink-0">✓</div>
                        <div>
                            <h4 class="font-bold text-gray-900 mb-1">Agilidade</h4>
                            <p class="text-sm text-gray-600 leading-relaxed">Logística inteligente para entrega e retirada de forma rápida.</p>
                        </div>
                    </div>
                    <div class="flex gap-4">
                        <div class="w-6 h-6 rounded bg-yellow-100 text-yellow-600 flex items-center justify-center shrink-0">✓</div>
                        <div>
                            <h4 class="font-bold text-gray-900 mb-1">Conformidade</h4>
                            <p class="text-sm text-gray-600 leading-relaxed">Nossa empresa obedece as normas da SEMA e prefeitura local.</p>
                        </div>
                    </div>
                    <div class="flex gap-4">
                        <div class="w-6 h-6 rounded bg-yellow-100 text-yellow-600 flex items-center justify-center shrink-0">✓</div>
                        <div>
                            <h4 class="font-bold text-gray-900 mb-1">Sustentabilidade</h4>
                            <p class="text-sm text-gray-600 leading-relaxed">Descarte ecológico em usinas e aterros legalizados.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Perguntas Frequentes -->
            <div>
                <h3 class="text-2xl font-black text-gray-900 mb-6 tracking-tighter">Perguntas Frequentes</h3>
                <div class="flex flex-col gap-3">
                    <details class="group bg-white border border-gray-200 rounded-2xl [&_summary::-webkit-details-marker]:hidden">
                        <summary class="flex cursor-pointer items-center justify-between gap-1.5 p-5 text-gray-900 font-bold">
                            Como escolho o tamanho da caçamba de entulho?
                            <span class="shrink-0 rounded-full bg-gray-50 p-1.5 text-gray-900 sm:p-3 group-open:-rotate-180 transition-transform">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                            </span>
                        </summary>
                        <div class="px-5 pb-5 text-gray-600 text-sm leading-relaxed">
                            A caçamba de 4m³ é indicada para reformas médias (pisos, azulejos e paredes). Para demolições grandes, recomendamos caçambas maiores ou roll-on. Fale conosco pelo WhatsApp e ajudamos a decidir!
                        </div>
                    </details>
                    <details class="group bg-white border border-gray-200 rounded-2xl [&_summary::-webkit-details-marker]:hidden">
                        <summary class="flex cursor-pointer items-center justify-between gap-1.5 p-5 text-gray-900 font-bold">
                            O que não posso descartar na caçamba?
                            <span class="shrink-0 rounded-full bg-gray-50 p-1.5 text-gray-900 sm:p-3 group-open:-rotate-180 transition-transform">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4-4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                            </span>
                        </summary>
                        <div class="px-5 pb-5 text-gray-600 text-sm leading-relaxed">
                            Resíduos orgânicos, lixo doméstico, animais mortos, produtos químicos e pneus não podem ser descartados em caçambas de entulho padrão da construção civil.
                        </div>
                    </details>
                    <details class="group bg-white border border-gray-200 rounded-2xl [&_summary::-webkit-details-marker]:hidden">
                        <summary class="flex cursor-pointer items-center justify-between gap-1.5 p-5 text-gray-900 font-bold">
                            Quanto tempo a caçamba pode ficar na rua?
                            <span class="shrink-0 rounded-full bg-gray-50 p-1.5 text-gray-900 sm:p-3 group-open:-rotate-180 transition-transform">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                            </span>
                        </summary>
                        <div class="px-5 pb-5 text-gray-600 text-sm leading-relaxed">
                            Por determinação da prefeitura, as caçambas podem permanecer na via pública por um período de tempo limitado (geralmente entre 3 a 5 dias). Para maior permanência, é necessário realizar a troca.
                        </div>
                    </details>
                    <details class="group bg-white border border-gray-200 rounded-2xl [&_summary::-webkit-details-marker]:hidden">
                        <summary class="flex cursor-pointer items-center justify-between gap-1.5 p-5 text-gray-900 font-bold">
                            Preciso de autorização da prefeitura para colocar na rua?
                            <span class="shrink-0 rounded-full bg-gray-50 p-1.5 text-gray-900 sm:p-3 group-open:-rotate-180 transition-transform">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                            </span>
                        </summary>
                        <div class="px-5 pb-5 text-gray-600 text-sm leading-relaxed">
                            Nós somos uma empresa regularizada e cuidamos de toda a documentação, porém é necessário respeitar as faixas de pedestre, guias rebaixadas e vagas de estacionamento restrito.
                        </div>
                    </details>
                </div>
            </div>

        </div>

        <!-- Coluna da Direita (Sidebar Sticky) -->
        <div class="w-full lg:w-1/3">
            <div class="sticky top-10 bg-green-700 rounded-[2rem] p-8 md:p-10 shadow-2xl shadow-green-700/30 flex flex-col items-center text-center">
                <div class="text-xs font-black uppercase tracking-widest text-white mb-3 opacity-90">Alugue agora mesmo com facilidade!</div>
                <h3 class="text-3xl font-black text-white mb-8 tracking-tighter leading-tight">Interessado neste modelo?</h3>
                
                <a href="https://wa.me/5511943758808" target="_blank" class="w-full flex justify-center items-center gap-3 px-6 py-4 bg-[#1c2331] text-white text-base font-black rounded-xl transition-all hover:scale-105 active:scale-95 mb-4 shadow-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                    </svg>
                    Pedir via WhatsApp
                </a>
                <a href="tel:+5511943758808" class="w-full flex justify-center items-center gap-3 px-6 py-4 bg-gray-100 text-gray-900 text-base font-black rounded-xl transition-all hover:bg-gray-200 hover:scale-105 active:scale-95 mb-8">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.539-4.239-7.136-7.136l1.292-.97c.363-.271.527-.734.418-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                    </svg>
                    Ligar Agora
                </a>
                
                <div class="text-xs font-bold text-white uppercase tracking-widest opacity-80 mb-2">Ou ligue para nossa central de atendimento:</div>
                <div class="text-xl font-black text-white tracking-tight">(11) 94375-8808</div>
            </div>
        </div>
    </section>
</Layout>
