---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { SITE_CONFIG } from '../../data/config';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
if (!post) return Astro.redirect('/404');
const { Content } = await render(post);

// Split title for dynamic highlight on hero
const titleWords = post.data.title.trim().split(/\s+/);
const splitIndex = titleWords.length > 3 ? titleWords.length - 2 : titleWords.length - 1;
const titleStart = titleWords.slice(0, splitIndex).join(' ');
const titleHighlight = titleWords.slice(splitIndex).join(' ');

// Posts relacionados
const allPosts = await getCollection('blog');
const relatedPosts = allPosts.filter(p => p.id !== post.id).slice(0, 3);
const whatsappLink = `https://wa.me/5511943758808?text=${encodeURIComponent(`Olá! Li o artigo "${post.data.title}" no blog e gostaria de um orçamento para aluguel de caçamba em Guarulhos.`)}`;
const phoneLink = `tel:+5511943758808`;
---

<Layout title={post.data.title} description={post.data.description}>
    <div class="flex flex-col gap-0 w-full max-w-7xl mx-auto px-4 sm:px-6">

        <!-- 1. Hero da Página (Idêntico ao Layout do Água Azul) -->
        <section class="max-w-5xl mx-auto w-full pt-16 pb-12 text-center px-4">
            <span class="inline-block py-1.5 px-4 rounded-full bg-green-700 text-white font-black text-xs mb-6 uppercase tracking-widest shadow-sm">
                Portal de Dicas • Guarulhos
            </span>

            <h1 class="text-4xl md:text-[47px] font-black text-gray-900 mb-6 tracking-tighter leading-tight">
                {titleStart} <span class="text-green-700">{titleHighlight}</span>
            </h1>

            <p class="text-lg text-gray-600 leading-relaxed max-w-2xl mx-auto font-medium mb-10">
                {post.data.description}
            </p>

            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="inline-flex justify-center items-center px-8 py-4 bg-green-700 text-white text-base font-black rounded-xl transition-all hover:scale-105 active:scale-95 shadow-xl hover:shadow-green-700/40 gap-2 w-full sm:w-auto">
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                    </svg>
                    Orçamento via WhatsApp
                </a>
                <a href="#conteudo" class="inline-flex justify-center items-center px-8 py-4 bg-gray-100 text-gray-900 text-base font-black rounded-xl transition-all hover:bg-gray-200 hover:scale-105 active:scale-95 gap-2 w-full sm:w-auto shadow-xl">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-5 h-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5" />
                    </svg>
                    Ler Artigo Completo
                </a>
            </div>
        </section>

        <!-- 2. Three Feature Cards Row (Idêntico ao Água Azul) -->
        <section class="max-w-6xl mx-auto w-full my-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Card 1 -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-start">
                    <div class="w-10 h-10 rounded-xl bg-green-700 text-white flex items-center justify-center font-black mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Orientação Prática</h3>
                    <p class="text-sm text-gray-600 leading-relaxed font-medium">
                        Dicas técnicas elaboradas por especialistas para você planejar sua obra e acertar na locação sem desperdício.
                    </p>
                </div>

                <!-- Card 2 -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-start">
                    <div class="w-10 h-10 rounded-xl bg-green-700 text-white flex items-center justify-center font-black mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Descarte 100% Legal</h3>
                    <p class="text-sm text-gray-600 leading-relaxed font-medium">
                        Conformidade com a legislação de Guarulhos e emissão dos documentos obrigatórios (CTR e MTR eletrônico).
                    </p>
                </div>

                <!-- Card 3 -->
                <div class="bg-white rounded-2xl p-6 sm:p-7 border border-gray-100 shadow-sm hover:shadow-md transition-shadow flex flex-col items-start">
                    <div class="w-10 h-10 rounded-xl bg-green-700 text-white flex items-center justify-center font-black mb-4">
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                            <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                        </svg>
                    </div>
                    <h3 class="text-lg font-black text-gray-900 mb-2 tracking-tight">Atendimento Imediato</h3>
                    <p class="text-sm text-gray-600 leading-relaxed font-medium">
                        Orçamento sem burocracia via WhatsApp e entrega pontual de caçambas em todos os bairros da cidade.
                    </p>
                </div>
            </div>
        </section>

        <!-- 3. Main Two-Column Content (Left: Document / Right: Sticky Sidebar Card) -->
        <section id="conteudo" class="max-w-6xl mx-auto w-full my-8 pb-16">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 lg:gap-10 items-start">

                <!-- Left Column: Content Container -->
                <article class="lg:col-span-2 bg-white rounded-3xl p-8 sm:p-12 border border-gray-100 shadow-sm">
                    <!-- Navegação / Breadcrumb no topo -->
                    <div class="pb-6 mb-8 border-b border-gray-100 flex items-center justify-between">
                        <a href="/blog" class="inline-flex items-center gap-2 text-sm font-bold text-gray-500 hover:text-green-700 transition-colors">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
                            </svg>
                            Voltar para o Blog
                        </a>
                        <span class="text-xs font-black text-green-700 bg-green-50 px-3 py-1 rounded-full uppercase tracking-wider">
                            DiskCaçamba Blog
                        </span>
                    </div>

                    <!-- Rendered Markdown Article Content -->
                    <div class="blog-content">
                        <Content />
                    </div>

                    <!-- Bloco de Conversão no Fim do Artigo -->
                    <div class="mt-12 pt-8 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4 bg-green-50/60 rounded-2xl p-6 sm:p-8">
                        <div>
                            <h4 class="text-xl font-black text-gray-900 mb-1">Pronto para iniciar sua obra?</h4>
                            <p class="text-sm text-gray-600 font-medium">Alugue sua caçamba agora com preço justo e pontualidade em Guarulhos.</p>
                        </div>
                        <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center px-6 py-3.5 bg-green-700 text-white font-black text-sm rounded-xl hover:bg-green-800 transition-all hover:scale-105 active:scale-95 shadow-lg whitespace-nowrap gap-2">
                            Pedir no WhatsApp
                        </a>
                    </div>
                </article>

                <!-- Right Column: Sticky Sidebar Card (Idêntico ao Água Azul) -->
                <aside class="w-full">
                    <div class="sticky top-28 bg-green-700 rounded-3xl p-6 sm:p-8 text-center shadow-2xl shadow-green-700/30 text-white">
                        <span class="inline-block text-xs font-black tracking-widest text-white/90 uppercase mb-4">
                            ORÇAMENTO GRATUITO
                        </span>
                        
                        <h3 class="text-2xl font-black text-white mb-6 leading-tight tracking-tight">
                            Interessado em alugar uma caçamba em Guarulhos?
                        </h3>

                        <div class="space-y-3 mb-6">
                            <a href={whatsappLink} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 w-full py-4 px-6 bg-[#1c2331] text-white font-black text-sm sm:text-base rounded-xl hover:bg-black transition-all hover:scale-[1.02] active:scale-95 shadow-xl">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                    <path d="M13.601 2.326A7.854 7.854 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.933 7.933 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.898 7.898 0 0 0 13.6 2.326zM7.994 14.521a6.573 6.573 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.557 6.557 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592zm3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.729.729 0 0 0-.529.247c-.182.198-.691.677-.691 1.654 0 .977.71 1.916.81 2.049.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232z"/>
                                </svg>
                                Pedir no WhatsApp
                            </a>
                            <a href={phoneLink} class="flex items-center justify-center gap-2 w-full py-4 px-6 bg-white text-gray-950 font-black text-sm sm:text-base rounded-xl hover:bg-gray-50 transition-all hover:scale-[1.02] active:scale-95 shadow-sm">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-2.896-1.596-5.539-4.239-7.136-7.136l1.292-.97c.363-.271.527-.734.418-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z" />
                                </svg>
                                Ligar Agora
                            </a>
                        </div>

                        <p class="text-xs font-bold text-white/80 mb-1">
                            Dúvidas? Fale com nossa equipe:
                        </p>
                        <a href={phoneLink} class="text-xl font-black text-white tracking-tight hover:underline block">
                            (11) 94375-8808
                        </a>
                    </div>
                </aside>

            </div>
        </section>

        <!-- 4. Outros Artigos Relacionados -->
        {relatedPosts.length > 0 && (
            <section class="max-w-6xl mx-auto w-full mb-16 pt-12 border-t border-gray-100">
                <div class="flex items-center justify-between mb-8">
                    <h2 class="text-2xl sm:text-3xl font-black text-gray-900 tracking-tight">
                        Outras Dicas do Blog
                    </h2>
                    <a href="/blog" class="text-sm font-bold text-green-700 hover:underline flex items-center gap-1">
                        Ver todos os artigos &rarr;
                    </a>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    {relatedPosts.map(related => (
                        <a href={`/blog/${related.id}`} class="block bg-white p-6 sm:p-7 rounded-2xl border border-gray-100 shadow-sm hover:shadow-xl hover:border-green-700/30 transition-all hover:-translate-y-1 group flex flex-col justify-between">
                            <div>
                                <span class="text-xs font-bold text-gray-400 uppercase tracking-wider block mb-2">
                                    Dica DiskCaçamba
                                </span>
                                <h3 class="text-lg font-black text-gray-900 group-hover:text-green-700 transition-colors mb-2 leading-snug">
                                    {related.data.title}
                                </h3>
                                <p class="text-gray-600 leading-relaxed line-clamp-3 text-sm font-medium mb-4">
                                    {related.data.description}
                                </p>
                            </div>
                            <span class="text-green-700 font-bold text-sm flex items-center gap-2 group-hover:gap-3 transition-all pt-3 border-t border-gray-50">
                                Ler artigo
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                                </svg>
                            </span>
                        </a>
                    ))}
                </div>
            </section>
        )}

    </div>
</Layout>

<style>
    /* Estilização refinada idêntica ao padrão de seções do Água Azul */
    .blog-content :global(h2) {
        font-size: 1.625rem; /* text-[26px] */
        font-weight: 900;
        color: #111827;
        letter-spacing: -0.025em;
        margin-top: 2.25rem;
        margin-bottom: 1rem;
        line-height: 1.25;
    }
    .blog-content :global(h2:first-child) {
        margin-top: 0;
    }
    .blog-content :global(h3) {
        font-size: 1.25rem; /* text-[20px] */
        font-weight: 900;
        color: #111827;
        letter-spacing: -0.02em;
        margin-top: 1.75rem;
        margin-bottom: 0.75rem;
        line-height: 1.3;
    }
    .blog-content :global(p) {
        font-size: 1rem;
        color: #4b5563; /* text-gray-600 */
        font-weight: 500;
        line-height: 1.75;
        margin-bottom: 1.25rem;
    }
    .blog-content :global(ul) {
        list-style: none;
        padding-left: 0.25rem;
        margin-bottom: 1.5rem;
    }
    .blog-content :global(ul li) {
        position: relative;
        padding-left: 1.5rem;
        margin-bottom: 0.65rem;
        font-size: 1rem;
        color: #4b5563;
        font-weight: 500;
        line-height: 1.6;
    }
    .blog-content :global(ul li::before) {
        content: "•";
        position: absolute;
        left: 0;
        color: #15803d; /* green-700 */
        font-weight: 900;
        font-size: 1.35rem;
        line-height: 1;
    }
    .blog-content :global(ol) {
        list-style: decimal;
        padding-left: 1.5rem;
        margin-bottom: 1.5rem;
    }
    .blog-content :global(ol li) {
        margin-bottom: 0.65rem;
        font-size: 1rem;
        color: #4b5563;
        font-weight: 500;
        line-height: 1.6;
        padding-left: 0.25rem;
    }
    .blog-content :global(ol li::marker) {
        color: #15803d;
        font-weight: 800;
    }
    .blog-content :global(blockquote) {
        border-left: 4px solid #eab308;
        background-color: #fefce8;
        padding: 1rem 1.25rem;
        border-radius: 0.75rem;
        margin: 1.5rem 0;
    }
    .blog-content :global(blockquote p) {
        color: #854d0e;
        margin-bottom: 0;
        font-weight: 600;
        font-size: 0.95rem;
    }
    .blog-content :global(strong) {
        color: #111827;
        font-weight: 800;
    }
    .blog-content :global(hr) {
        border: none;
        border-top: 1px solid #f3f4f6;
        margin: 2rem 0;
    }
    .blog-content :global(a) {
        color: #15803d;
        font-weight: 700;
        text-decoration: underline;
        text-underline-offset: 3px;
        transition: all 0.2s ease;
    }
    .blog-content :global(a:hover) {
        color: #166534;
        text-decoration-color: #166534;
    }
    .blog-content :global(img) {
        max-width: 100%;
        height: auto;
        border-radius: 1.25rem;
        margin: 2rem auto;
        display: block;
        box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.08);
        border: 1px solid #f3f4f6;
    }
</style>
