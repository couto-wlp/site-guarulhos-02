			</svg>
		</button>
	</div>

    <!-- Menu Mobile Indestrutível -->
    <div id="mobile-drawer" class="fixed inset-0 z-[999] bg-accent/95 backdrop-blur-xl hidden flex-col justify-center items-center">
        <button id="close-menu-btn" class="absolute top-8 right-8 text-white hover:text-green-700 hover:scale-110 active:scale-90 transition-all p-2">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="3" stroke="currentColor" class="w-12 h-12">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
        <nav class="flex flex-col items-center gap-6 font-black text-white text-4xl tracking-tighter">
            <a href="/" class="mobile-link hover:text-green-700 hover:scale-105 active:scale-95 transition-all">Home</a>
            <a href="/servicos" class="mobile-link hover:text-green-700 hover:scale-105 active:scale-95 transition-all">Serviços</a>
            <a href="/bairros" class="mobile-link hover:text-green-700 hover:scale-105 active:scale-95 transition-all">Bairros de Atuação</a>
            <a href="/sobre" class="mobile-link hover:text-green-700 hover:scale-105 active:scale-95 transition-all">Sobre Nós</a>
            <a href="/contato" class="mobile-link hover:text-green-700 hover:scale-105 active:scale-95 transition-all">Contato</a>
        </nav>
        <a href="https://wa.me/5511943758808" target="_blank" class="mt-16 px-10 py-5 bg-green-700 text-white text-base font-black rounded-xl hover:scale-105 active:scale-95 transition-all shadow-xl hover:shadow-green-700/40 flex items-center gap-3">
            Chamar no WhatsApp
        </a>
    </div>
</header>

<script>
    const mobileBtn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('close-menu-btn');
    const drawer = document.getElementById('mobile-drawer');
    const links = document.querySelectorAll('.mobile-link');

    function openMenu() {
        if(drawer) drawer.classList.remove('hidden');
        if(drawer) drawer.classList.add('flex');
        document.body.style.overflow = 'hidden';
    }

    function closeMenu() {
        if(drawer) drawer.classList.add('hidden');
        if(drawer) drawer.classList.remove('flex');
        document.body.style.overflow = '';
    }

    if(mobileBtn) mobileBtn.addEventListener('click', openMenu);
    if(closeBtn) closeBtn.addEventListener('click', closeMenu);
    links.forEach(link => link.addEventListener('click', closeMenu));
</script>

