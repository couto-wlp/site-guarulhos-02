---
import { SITE_CONFIG } from '../data/config';
---

<footer class="bg-gray-50 pt-24 pb-12 border-t border-gray-200">
	<div class="container mx-auto px-6 md:px-12">
		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12 lg:gap-8 mb-16">
			<!-- Coluna 1: Logo e Descrição -->
			<div>
				<div class="text-3xl font-black text-gray-900 tracking-tight mb-6 flex items-center gap-3">
					<span>DiskCaçamba</span>
				</div>
				<p class="text-gray-600 leading-relaxed mb-8 text-sm">
					Locação de caçambas estacionárias licenciadas para coleta e destinação ecologicamente correta de resíduos da construção civil em Guarulhos e região.
				</p>
				<div class="flex items-center gap-3">
					<a href={SITE_CONFIG.social.facebook} target="_blank" class="w-10 h-10 flex items-center justify-center border border-gray-200 rounded-lg text-gray-500 hover:text-primary hover:border-primary transition-colors bg-white">
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z"/></svg>
					</a>
					<a href={SITE_CONFIG.social.instagram} target="_blank" class="w-10 h-10 flex items-center justify-center border border-gray-200 rounded-lg text-gray-500 hover:text-primary hover:border-primary transition-colors bg-white">
						<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
					</a>
				</div>
			</div>
			
			<!-- Coluna 2: Navegação -->
			<div>
				<h3 class="text-green-700 font-black text-sm uppercase tracking-widest mb-6">Navegação Rápida</h3>
				<ul class="space-y-4 text-gray-600 font-medium text-sm">
					<li><a href="/" class="hover:text-primary transition-colors flex items-center gap-3"><span class="w-1.5 h-1.5 bg-green-700 inline-block"></span> Home</a></li>
					<li><a href="/servicos" class="hover:text-primary transition-colors flex items-center gap-3"><span class="w-1.5 h-1.5 bg-green-700 inline-block"></span> Serviços</a></li>
					<li><a href="/bairros" class="hover:text-primary transition-colors flex items-center gap-3"><span class="w-1.5 h-1.5 bg-green-700 inline-block"></span> Bairros de Atuação</a></li>
					<li><a href="/sobre" class="hover:text-primary transition-colors flex items-center gap-3"><span class="w-1.5 h-1.5 bg-green-700 inline-block"></span> Sobre Nós</a></li>
					<li><a href="/contato" class="hover:text-primary transition-colors flex items-center gap-3"><span class="w-1.5 h-1.5 bg-green-700 inline-block"></span> Contato</a></li>
					<li><a href="/blog" class="hover:text-primary transition-colors flex items-center gap-3"><span class="w-1.5 h-1.5 bg-green-700 inline-block"></span> Blog</a></li>
				</ul>
			</div>
			
			<!-- Coluna 3: Suporte -->
			<div>
				<h3 class="text-green-700 font-black text-sm uppercase tracking-widest mb-6">Suporte & Logística</h3>
				<ul class="space-y-6 text-gray-600 font-medium text-sm">
					<li class="flex items-start gap-3">
						<svg class="w-5 h-5 text-green-700 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
						<div>
							<span class="block text-gray-500 mb-1">Ligação</span>
							<span class="block text-gray-900">{SITE_CONFIG.contact.phone}</span>
						</div>
					</li>
					<li class="flex items-start gap-3">
						<svg class="w-5 h-5 text-green-700 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path></svg>
						<div>
							<span class="block text-gray-500 mb-1">WhatsApp 24h</span>
							<span class="block text-gray-900">{SITE_CONFIG.contact.phone}</span>
						</div>
					</li>
					<li class="flex items-start gap-3">
						<svg class="w-5 h-5 text-green-700 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
						<div>
							<span class="block text-gray-500 mb-1">E-mail Comercial</span>
							<span class="block text-gray-900">{SITE_CONFIG.contact.email}</span>
						</div>
					</li>
				</ul>
			</div>

			<!-- Coluna 4: Operação -->
			<div>
				<h3 class="text-green-700 font-black text-sm uppercase tracking-widest mb-6">Operação & Meio Ambiente</h3>
				<ul class="space-y-6 text-gray-600 font-medium text-sm">
					<li class="flex items-start gap-3">
						<svg class="w-5 h-5 text-green-700 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
						<div>
							<span class="block text-gray-900">{SITE_CONFIG.address.streetAddress}</span>
							<span class="block text-gray-900">{SITE_CONFIG.address.addressLocality} - {SITE_CONFIG.address.addressRegion}, {SITE_CONFIG.address.postalCode}</span>
						</div>
					</li>
					<li class="pt-2 border-t border-gray-100">
						<span class="block text-gray-500 mb-1">Licença SMMA:</span>
						<span class="block text-gray-900 font-bold">L.O. nº 0387/24</span>
					</li>
					<li class="pt-2 border-t border-gray-100">
						<span class="block text-gray-500 mb-1">Registro ATT:</span>
						<span class="block text-gray-900 font-bold">ATT-GR nº 092/24</span>
					</li>
				</ul>
			</div>
		</div>
		
		<div class="border-t border-gray-200 pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-gray-500 font-medium text-sm text-center md:text-left">
			<p>&copy; {new Date().getFullYear()} {SITE_CONFIG.name}. Todos os direitos reservados.</p>
			<div class="flex flex-wrap items-center justify-center gap-6">
				<a href="/privacidade" class="hover:text-primary transition-colors">Política de Privacidade</a>
				<a href="/termos" class="hover:text-primary transition-colors">Termos de Uso</a>
			</div>
		</div>
	</div>
</footer>
